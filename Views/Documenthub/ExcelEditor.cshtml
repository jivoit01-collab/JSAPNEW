@using JSAPNEW.Models
@{
    Layout = null;
    var permissions = ViewBag.DocumentHubPermissions as DocumentHubPermissionDto ?? new DocumentHubPermissionDto();
    var fileId = (int)(ViewBag.FileId ?? 0);
    var fileName = (string)(ViewBag.FileName ?? "Workbook.xlsx");
    var returnFolderId = ViewBag.ReturnFolderId;
    var returnFilter = (string)(ViewBag.ReturnFilter ?? string.Empty);
    var returnSearch = (string)(ViewBag.ReturnSearch ?? string.Empty);
    var fileNameJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(fileName));
    var returnFolderIdJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnFolderId?.ToString() ?? string.Empty));
    var returnFilterJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnFilter));
    var returnSearchJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnSearch));
    var fileTypeJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)(ViewBag.FileType ?? string.Empty)));
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fileName - Document Hub</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <style>
        .excel-editor-container {
            --xl-border: #d9e2ec;
            --xl-head: #f3f6fa;
            --xl-green: #107c41;
            --xl-blue: #2563eb;
            --xl-text: #111827;
            --xl-muted: #64748b;
            height: 100vh;
            margin: 0;
            overflow: hidden;
            font-family: "Segoe UI", Arial, sans-serif;
            color: var(--xl-text);
        }
        .excel-editor-container .xl-app { height: 100vh; display: grid; grid-template-rows: auto auto minmax(0,1fr) auto; background: #fff; }
        .excel-editor-container .xl-toolbar { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: #fff; border-bottom: 1px solid var(--xl-border); flex-wrap: wrap; }
        .excel-editor-container .xl-toolbar .btn { border-radius: 4px; font-size: 13px; font-weight: 600; }
        .excel-editor-container .xl-title { font-weight: 700; max-width: 360px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 8px; }
        .excel-editor-container .xl-status { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; font-size: 12px; color: var(--xl-muted); }
        .excel-editor-container .xl-status-badge { border: 1px solid var(--xl-border); border-radius: 999px; padding: 4px 10px; background: #f8fafc; color: var(--xl-text); font-weight: 700; }
        .excel-editor-container .xl-formula { display: grid; grid-template-columns: 110px minmax(0,1fr); gap: 8px; align-items: center; padding: 8px 12px; border-bottom: 1px solid var(--xl-border); background: #f8fafc; }
        .excel-editor-container .xl-name-box,
        .excel-editor-container .xl-formula-input,
        .excel-editor-container .xl-search-input { border: 1px solid var(--xl-border); border-radius: 4px; height: 32px; padding: 4px 8px; font-size: 13px; background: #fff; }
        .excel-editor-container .xl-grid-wrap { overflow: auto; min-height: 0; position: relative; background: #fff; }
        .excel-editor-container .xl-grid { border-collapse: separate; border-spacing: 0; table-layout: fixed; width: max-content; min-width: 100%; font-size: 13px; }
        .excel-editor-container .xl-grid th,
        .excel-editor-container .xl-grid td { border-right: 1px solid var(--xl-border); border-bottom: 1px solid var(--xl-border); padding: 0; background: #fff; position: relative; }
        .excel-editor-container .xl-grid th { height: 28px; background: var(--xl-head); color: #475569; text-align: center; font-weight: 700; user-select: none; position: sticky; top: 0; z-index: 4; }
        .excel-editor-container .xl-grid .corner { left: 0; z-index: 6; width: 56px; min-width: 56px; }
        .excel-editor-container .xl-grid .row-head { width: 56px; min-width: 56px; text-align: center; position: sticky; left: 0; z-index: 3; background: var(--xl-head); color: #475569; font-weight: 700; user-select: none; }
        .excel-editor-container .xl-cell { width: 120px; min-width: 120px; height: 28px; padding: 4px 6px; outline: none; white-space: nowrap; overflow: hidden; }
        .excel-editor-container .xl-cell.active { box-shadow: inset 0 0 0 2px var(--xl-green); background: #ecfdf5; }
        .excel-editor-container .xl-cell.selected { background: #dbeafe; }
        .excel-editor-container .xl-cell.cut-source { outline: 2px dashed #ef4444; outline-offset: -2px; }
        .excel-editor-container .xl-cell.search-hit { background: #fef3c7; }
        .excel-editor-container .col-resizer { position: absolute; top: 0; right: -3px; width: 6px; height: 100%; cursor: col-resize; z-index: 8; }
        .excel-editor-container .row-resizer { position: absolute; right: 0; bottom: -3px; width: 100%; height: 6px; cursor: row-resize; z-index: 8; }
        .excel-editor-container .xl-tabs { display: flex; align-items: center; gap: 6px; padding: 8px 12px; background: #f8fafc; border-top: 1px solid var(--xl-border); overflow-x: auto; }
        .excel-editor-container .xl-tab { border: 1px solid var(--xl-border); background: #fff; border-radius: 4px; padding: 6px 12px; font-size: 12px; font-weight: 700; white-space: nowrap; }
        .excel-editor-container .xl-tab.active { color: #fff; background: var(--xl-green); border-color: var(--xl-green); }
        .excel-editor-container .xl-nav { display: inline-flex; align-items: center; gap: 4px; }
        .excel-editor-container .xl-version-panel { position: fixed; right: 14px; top: 58px; width: 360px; max-height: 70vh; overflow: auto; z-index: 30; background: #fff; border: 1px solid var(--xl-border); box-shadow: 0 18px 40px rgba(15,23,42,.16); display: none; }
        .excel-editor-container .xl-version-panel.show { display: block; }
        .excel-editor-container .toast-lite { position: fixed; right: 18px; bottom: 18px; z-index: 40; display: none; padding: 10px 14px; border-radius: 6px; color: #fff; font-weight: 700; background: var(--xl-green); }
    </style>
</head>
<body class="excel-editor-container">
    <div class="xl-app">
        <div class="xl-toolbar">
            <button class="btn btn-outline-secondary btn-sm" onclick="backToHub()"><i class="fa-solid fa-arrow-left"></i> Back to Document Hub</button>
            <span class="xl-title" title="@fileName"><i class="fa-solid fa-file-excel text-success"></i> @fileName</span>
            <button class="btn btn-success btn-sm" id="saveBtn" onclick="saveWorkbook(false)"><i class="fa-solid fa-floppy-disk"></i> Save</button>
            <button class="btn btn-outline-success btn-sm" onclick="saveAndReturn()"><i class="fa-solid fa-check"></i> Save & Return</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="undoChange()"><i class="fa-solid fa-rotate-left"></i> Undo</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="redoChange()"><i class="fa-solid fa-rotate-right"></i> Redo</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="addRow()"><i class="fa-solid fa-plus"></i> Row</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="deleteRow()"><i class="fa-solid fa-minus"></i> Row</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="addColumn()"><i class="fa-solid fa-plus"></i> Column</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="deleteColumn()"><i class="fa-solid fa-minus"></i> Column</button>
            <input class="xl-search-input" id="searchInput" placeholder="Search" oninput="applySearch()" />
            <button class="btn btn-outline-secondary btn-sm" onclick="toggleFilter()"><i class="fa-solid fa-filter"></i> Filter</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="downloadWorkbook()"><i class="fa-solid fa-download"></i> Download</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="refreshWorkbook()"><i class="fa-solid fa-arrows-rotate"></i> Refresh</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="toggleVersions()"><i class="fa-solid fa-code-branch"></i> Versions</button>
            <span class="xl-status"><span id="windowLabel">-</span><span class="xl-status-badge" id="saveStatus">Loading...</span></span>
        </div>
        <div class="xl-formula">
            <input class="xl-name-box" id="nameBox" readonly value="A1" />
            <input class="xl-formula-input" id="formulaBar" placeholder="Formula bar" onkeydown="formulaKeydown(event)" />
        </div>
        <div class="xl-grid-wrap" id="gridWrap"></div>
        <div class="xl-tabs" id="sheetTabs"></div>
    </div>
    <div class="xl-version-panel rounded" id="versionPanel">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
            <strong>Version History</strong>
            <button class="btn btn-sm btn-light" onclick="toggleVersions(false)"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div id="versionRows" class="p-2 small text-muted">Loading...</div>
    </div>
    <div class="toast-lite" id="toastLite"></div>

    <script>
        const editor = {
            fileId: @fileId,
            fileName: @fileNameJson,
            fileType: @fileTypeJson,
            canSave: @permissions.CanUpload.ToString().ToLowerInvariant(),
            canDownload: @permissions.CanDownload.ToString().ToLowerInvariant(),
            canRestore: @permissions.CanRename.ToString().ToLowerInvariant(),
            returnFolderId: @returnFolderIdJson,
            returnFilter: @returnFilterJson,
            returnSearch: @returnSearchJson,
            workbook: null,
            sheetName: "",
            rowStart: 0,
            colStart: 0,
            rowWindow: 240,
            colWindow: 60,
            dirty: false,
            saving: false,
            autosaveTimer: null,
            active: { r: 0, c: 0 },
            selection: null,
            clipboardCut: null,
            undo: [],
            redo: [],
            filterOn: false,
            search: "",
            csvDelimiter: ",",
            csvHasBom: false,
            colWidths: {},
            rowHeights: {}
        };

        window.addEventListener("beforeunload", e => {
            if (!editor.dirty) return;
            e.preventDefault();
            e.returnValue = "";
        });

        document.addEventListener("keydown", e => {
            if (e.ctrlKey && e.key.toLowerCase() === "s") { e.preventDefault(); saveWorkbook(false); }
            if (e.ctrlKey && e.key.toLowerCase() === "z") { e.preventDefault(); undoChange(); }
            if (e.ctrlKey && e.key.toLowerCase() === "y") { e.preventDefault(); redoChange(); }
            if (e.ctrlKey && e.key.toLowerCase() === "c") copySelection(false);
            if (e.ctrlKey && e.key.toLowerCase() === "x") copySelection(true);
            if (e.ctrlKey && e.key.toLowerCase() === "v") pasteFromClipboard(e);
        });

        loadWorkbook();

        async function loadWorkbook() {
            try {
                setStatus("Loading...");
                const res = await fetch(`/DocumentHub/Preview?fileId=${editor.fileId}`, { cache: "no-store" });
                if (!res.ok) throw new Error("Unable to load spreadsheet.");
                const buffer = await res.arrayBuffer();
                if (isCsvFile()) {
                    const csvText = decodeCsv(buffer);
                    editor.csvDelimiter = detectCsvDelimiter(csvText);
                    editor.workbook = XLSX.read(csvText, { type: "string", raw: false, FS: editor.csvDelimiter });
                } else {
                    editor.workbook = XLSX.read(buffer, { type: "array", cellDates: true, cellFormula: true, cellStyles: true });
                }
                editor.sheetName = editor.workbook.SheetNames[0] || "";
                renderTabs();
                renderGrid();
                setStatus("Saved ✓");
                setInterval(() => { if (editor.dirty) saveWorkbook(true); }, 10000);
            } catch (err) {
                gridWrap.innerHTML = `<div class="p-4 text-danger">${escapeHtml(err.message || "Spreadsheet failed to load.")}</div>`;
                setStatus("Load failed");
            }
        }

        function renderTabs() {
            sheetTabs.innerHTML = editor.workbook.SheetNames.map((name, index) =>
                `<button class="xl-tab ${name === editor.sheetName ? "active" : ""}" onclick="selectSheet(${index})">${escapeHtml(name)}</button>`
            ).join("");
        }

        function selectSheet(index) {
            if (editor.dirty && !confirm("Switch sheets with unsaved changes? Auto-save will keep trying every 10 seconds.")) return;
            editor.sheetName = editor.workbook.SheetNames[index];
            editor.rowStart = 0;
            editor.colStart = 0;
            editor.active = { r: 0, c: 0 };
            editor.selection = null;
            renderTabs();
            renderGrid();
        }

        function renderGrid() {
            const sheet = activeSheet();
            const range = getRange(sheet);
            const rowEnd = Math.min(range.e.r, editor.rowStart + editor.rowWindow - 1);
            const colEnd = Math.min(range.e.c, editor.colStart + editor.colWindow - 1);
            let html = `<table class="xl-grid"><thead><tr><th class="corner"></th>`;
            for (let c = editor.colStart; c <= colEnd; c++) {
                const width = editor.colWidths[c] || 120;
                html += `<th style="width:${width}px;min-width:${width}px">${XLSX.utils.encode_col(c)}<span class="col-resizer" onmousedown="startColResize(event,${c})"></span></th>`;
            }
            html += `</tr></thead><tbody>`;
            for (let r = editor.rowStart; r <= rowEnd; r++) {
                if (editor.filterOn && editor.search && !rowMatches(sheet, r, range.e.c)) continue;
                const height = editor.rowHeights[r] || 28;
                html += `<tr style="height:${height}px"><th class="row-head">${r + 1}<span class="row-resizer" onmousedown="startRowResize(event,${r})"></span></th>`;
                for (let c = editor.colStart; c <= colEnd; c++) {
                    const address = XLSX.utils.encode_cell({ r, c });
                    const cls = cellClass(r, c, getCellText(sheet[address]));
                    const width = editor.colWidths[c] || 120;
                    html += `<td><div class="xl-cell ${cls}" style="width:${width}px;min-width:${width}px;height:${height - 1}px" contenteditable="true" data-r="${r}" data-c="${c}" onfocus="activateCell(this)" onmousedown="selectCellMouse(event,this)" oninput="cellInput(this)" onkeydown="cellKeydown(event,this)">${escapeHtml(getCellText(sheet[address]))}</div></td>`;
                }
                html += `</tr>`;
            }
            html += `</tbody></table>`;
            gridWrap.innerHTML = html;
            windowLabel.textContent = `Rows ${editor.rowStart + 1}-${rowEnd + 1}, Columns ${XLSX.utils.encode_col(editor.colStart)}-${XLSX.utils.encode_col(colEnd)}`;
        }

        function activeSheet() { return editor.workbook.Sheets[editor.sheetName]; }
        function getRange(sheet) {
            if (!sheet["!ref"]) return { s: { r: 0, c: 0 }, e: { r: 999, c: 25 } };
            const range = XLSX.utils.decode_range(sheet["!ref"]);
            range.e.r = Math.max(range.e.r, editor.rowStart + editor.rowWindow - 1, 99);
            range.e.c = Math.max(range.e.c, editor.colStart + editor.colWindow - 1, 25);
            return range;
        }
        function getCellText(cell) { if (!cell) return ""; if (cell.f) return `=${cell.f}`; return cell.v == null ? "" : String(cell.v); }

        function isCsvFile() {
            const ext = (editor.fileType || editor.fileName.split(".").pop() || "").toLowerCase().replace(".", "");
            return ext === "csv";
        }

        function decodeCsv(buffer) {
            const bytes = new Uint8Array(buffer);
            editor.csvHasBom = bytes.length >= 3 && bytes[0] === 0xEF && bytes[1] === 0xBB && bytes[2] === 0xBF;
            if (bytes.length >= 2 && bytes[0] === 0xFF && bytes[1] === 0xFE) return new TextDecoder("utf-16le").decode(bytes);
            if (bytes.length >= 2 && bytes[0] === 0xFE && bytes[1] === 0xFF) return new TextDecoder("utf-16be").decode(bytes);
            return new TextDecoder("utf-8").decode(bytes);
        }

        function detectCsvDelimiter(text) {
            const sample = text.split(/\r?\n/).slice(0, 20).join("\n");
            const candidates = [",", ";", "\t", "|"];
            let best = ",";
            let bestScore = -1;
            candidates.forEach(delimiter => {
                const score = sample.split(/\r?\n/).reduce((sum, line) => sum + countDelimiterOutsideQuotes(line, delimiter), 0);
                if (score > bestScore) {
                    bestScore = score;
                    best = delimiter;
                }
            });
            return best;
        }

        function countDelimiterOutsideQuotes(line, delimiter) {
            let count = 0;
            let quoted = false;
            for (let i = 0; i < line.length; i++) {
                const ch = line[i];
                if (ch === '"' && line[i + 1] === '"') { i++; continue; }
                if (ch === '"') quoted = !quoted;
                else if (!quoted && ch === delimiter) count++;
            }
            return count;
        }

        function sheetToDelimitedText(sheet, delimiter) {
            const range = findUsedRange(sheet);
            const rows = [];
            for (let r = range.s.r; r <= range.e.r; r++) {
                const cols = [];
                for (let c = range.s.c; c <= range.e.c; c++) {
                    cols.push(escapeDelimitedValue(getCellText(sheet[XLSX.utils.encode_cell({ r, c })]), delimiter));
                }
                rows.push(cols.join(delimiter));
            }
            return rows.join("\r\n");
        }

        function escapeDelimitedValue(value, delimiter) {
            const text = String(value ?? "");
            return (text.includes('"') || text.includes("\n") || text.includes("\r") || text.includes(delimiter))
                ? `"${text.replace(/"/g, '""')}"`
                : text;
        }

        function findUsedRange(sheet) {
            let maxR = 0, maxC = 0, seen = false;
            Object.keys(sheet).forEach(address => {
                if (address[0] === "!") return;
                const cell = sheet[address];
                if (!cell || getCellText(cell) === "") return;
                const pos = XLSX.utils.decode_cell(address);
                maxR = Math.max(maxR, pos.r);
                maxC = Math.max(maxC, pos.c);
                seen = true;
            });
            if (!seen && sheet["!ref"]) return XLSX.utils.decode_range(sheet["!ref"]);
            return { s: { r: 0, c: 0 }, e: { r: maxR, c: maxC } };
        }

        function activateCell(el) {
            editor.active = { r: +el.dataset.r, c: +el.dataset.c };
            editor.selection = editor.selection || { start: editor.active, end: editor.active };
            nameBox.value = XLSX.utils.encode_cell(editor.active);
            formulaBar.value = el.textContent;
            document.querySelectorAll(".xl-cell.active").forEach(x => x.classList.remove("active"));
            el.classList.add("active");
        }

        function selectCellMouse(event, el) {
            const pos = { r: +el.dataset.r, c: +el.dataset.c };
            if (event.shiftKey && editor.selection) editor.selection.end = pos;
            else editor.selection = { start: pos, end: pos };
            setTimeout(renderSelection, 0);
        }

        function renderSelection() {
            document.querySelectorAll(".xl-cell.selected").forEach(x => x.classList.remove("selected"));
            if (!editor.selection) return;
            const s = normalizeSelection();
            document.querySelectorAll(".xl-cell").forEach(el => {
                const r = +el.dataset.r, c = +el.dataset.c;
                if (r >= s.r1 && r <= s.r2 && c >= s.c1 && c <= s.c2) el.classList.add("selected");
            });
        }

        function cellInput(el) {
            const r = +el.dataset.r, c = +el.dataset.c;
            setCellValue(r, c, el.textContent, true);
            formulaBar.value = el.textContent;
        }

        function setCellValue(r, c, value, track) {
            const sheet = activeSheet();
            const address = XLSX.utils.encode_cell({ r, c });
            const before = getCellText(sheet[address]);
            if (before === value) return;
            if (track) pushUndo([{ r, c, before, after: value }]);
            if (value === "") delete sheet[address];
            else if (value.startsWith("=")) sheet[address] = { f: value.slice(1), t: "n" };
            else {
                const numberValue = Number(value);
                const isNumber = value.trim() !== "" && !Number.isNaN(numberValue) && /^-?\d+(\.\d+)?$/.test(value.trim());
                sheet[address] = { v: isNumber ? numberValue : value, t: isNumber ? "n" : "s" };
            }
            expandRef(sheet, r, c);
            markDirty();
        }

        function formulaKeydown(e) {
            if (e.key !== "Enter") return;
            e.preventDefault();
            setCellValue(editor.active.r, editor.active.c, formulaBar.value, true);
            renderGrid();
        }

        function cellKeydown(e, el) {
            const r = +el.dataset.r, c = +el.dataset.c;
            const moves = { ArrowUp: [-1,0], ArrowDown: [1,0], ArrowLeft: [0,-1], ArrowRight: [0,1], Enter: [1,0], Tab: [0,1] };
            if (!moves[e.key]) return;
            e.preventDefault();
            const [dr, dc] = moves[e.key];
            focusCell(Math.max(0, r + dr), Math.max(0, c + dc));
        }

        function focusCell(r, c) {
            if (r < editor.rowStart || r >= editor.rowStart + editor.rowWindow) editor.rowStart = Math.max(0, r - 10);
            if (c < editor.colStart || c >= editor.colStart + editor.colWindow) editor.colStart = Math.max(0, c - 5);
            renderGrid();
            const el = document.querySelector(`.xl-cell[data-r="${r}"][data-c="${c}"]`);
            if (el) el.focus();
        }

        function copySelection(cut) {
            const s = normalizeSelection();
            const sheet = activeSheet();
            const rows = [];
            for (let r = s.r1; r <= s.r2; r++) {
                const cols = [];
                for (let c = s.c1; c <= s.c2; c++) cols.push(getCellText(sheet[XLSX.utils.encode_cell({ r, c })]));
                rows.push(cols.join("\t"));
            }
            navigator.clipboard?.writeText(rows.join("\n"));
            editor.clipboardCut = cut ? s : null;
        }

        async function pasteFromClipboard(e) {
            e.preventDefault();
            const text = await navigator.clipboard.readText();
            if (!text) return;
            const start = editor.active;
            const changes = [];
            text.split(/\r?\n/).forEach((row, ri) => row.split("\t").forEach((value, ci) => {
                const r = start.r + ri, c = start.c + ci;
                const before = getCellText(activeSheet()[XLSX.utils.encode_cell({ r, c })]);
                changes.push({ r, c, before, after: value });
                setCellValue(r, c, value, false);
            }));
            if (editor.clipboardCut) {
                for (let r = editor.clipboardCut.r1; r <= editor.clipboardCut.r2; r++)
                    for (let c = editor.clipboardCut.c1; c <= editor.clipboardCut.c2; c++)
                        setCellValue(r, c, "", false);
                editor.clipboardCut = null;
            }
            pushUndo(changes);
            renderGrid();
        }

        function pushUndo(changes) { editor.undo.push(changes); editor.redo = []; if (editor.undo.length > 100) editor.undo.shift(); }
        function undoChange() { const changes = editor.undo.pop(); if (!changes) return; changes.forEach(x => setCellValue(x.r, x.c, x.before, false)); editor.redo.push(changes); markDirty(); renderGrid(); }
        function redoChange() { const changes = editor.redo.pop(); if (!changes) return; changes.forEach(x => setCellValue(x.r, x.c, x.after, false)); editor.undo.push(changes); markDirty(); renderGrid(); }

        function addRow() {
            const sheet = activeSheet();
            const range = findUsedRange(sheet);
            const insertAt = editor.active.r + 1;
            for (let r = range.e.r; r >= insertAt; r--) moveRow(sheet, r, r + 1, range.e.c);
            for (let c = 0; c <= range.e.c; c++) delete sheet[XLSX.utils.encode_cell({ r: insertAt, c })];
            sheet["!ref"] = XLSX.utils.encode_range({ s: range.s, e: { r: range.e.r + 1, c: range.e.c } });
            markDirty();
            renderGrid();
        }

        function deleteRow() {
            const sheet = activeSheet();
            const range = findUsedRange(sheet);
            const deleteAt = editor.active.r;
            for (let r = deleteAt + 1; r <= range.e.r; r++) moveRow(sheet, r, r - 1, range.e.c);
            for (let c = 0; c <= range.e.c; c++) delete sheet[XLSX.utils.encode_cell({ r: range.e.r, c })];
            sheet["!ref"] = XLSX.utils.encode_range({ s: range.s, e: { r: Math.max(0, range.e.r - 1), c: range.e.c } });
            editor.active.r = Math.min(editor.active.r, Math.max(0, range.e.r - 1));
            markDirty();
            renderGrid();
        }

        function addColumn() {
            const sheet = activeSheet();
            const range = findUsedRange(sheet);
            const insertAt = editor.active.c + 1;
            for (let c = range.e.c; c >= insertAt; c--) moveColumn(sheet, c, c + 1, range.e.r);
            for (let r = 0; r <= range.e.r; r++) delete sheet[XLSX.utils.encode_cell({ r, c: insertAt })];
            sheet["!ref"] = XLSX.utils.encode_range({ s: range.s, e: { r: range.e.r, c: range.e.c + 1 } });
            markDirty();
            renderGrid();
        }

        function deleteColumn() {
            const sheet = activeSheet();
            const range = findUsedRange(sheet);
            const deleteAt = editor.active.c;
            for (let c = deleteAt + 1; c <= range.e.c; c++) moveColumn(sheet, c, c - 1, range.e.r);
            for (let r = 0; r <= range.e.r; r++) delete sheet[XLSX.utils.encode_cell({ r, c: range.e.c })];
            sheet["!ref"] = XLSX.utils.encode_range({ s: range.s, e: { r: range.e.r, c: Math.max(0, range.e.c - 1) } });
            editor.active.c = Math.min(editor.active.c, Math.max(0, range.e.c - 1));
            markDirty();
            renderGrid();
        }

        function moveRow(sheet, fromR, toR, maxC) {
            for (let c = 0; c <= maxC; c++) moveCell(sheet, fromR, c, toR, c);
        }

        function moveColumn(sheet, fromC, toC, maxR) {
            for (let r = 0; r <= maxR; r++) moveCell(sheet, r, fromC, r, toC);
        }

        function moveCell(sheet, fromR, fromC, toR, toC) {
            const from = XLSX.utils.encode_cell({ r: fromR, c: fromC });
            const to = XLSX.utils.encode_cell({ r: toR, c: toC });
            if (sheet[from]) sheet[to] = { ...sheet[from] };
            else delete sheet[to];
        }

        function applySearch() { editor.search = searchInput.value.toLowerCase(); renderGrid(); }
        function toggleFilter() { editor.filterOn = !editor.filterOn; renderGrid(); toast(editor.filterOn ? "Filter on" : "Filter off"); }
        function rowMatches(sheet, r, maxCol) { for (let c = 0; c <= maxCol; c++) if (getCellText(sheet[XLSX.utils.encode_cell({ r, c })]).toLowerCase().includes(editor.search)) return true; return false; }
        function cellClass(r, c, text) {
            const classes = [];
            if (editor.active.r === r && editor.active.c === c) classes.push("active");
            if (editor.search && text.toLowerCase().includes(editor.search)) classes.push("search-hit");
            return classes.join(" ");
        }

        async function saveWorkbook(auto) {
            if (!editor.canSave) return toast("You do not have permission to save this spreadsheet.", true);
            if (editor.saving || (auto && !editor.dirty)) return;
            editor.saving = true;
            setStatus("Saving...");
            try {
                const output = serializeSpreadsheet();
                const fd = new FormData();
                fd.append("fileId", editor.fileId);
                fd.append("workbook", new Blob([output.content], { type: output.contentType }), editor.fileName);
                const res = await fetch("/DocumentHub/SaveSpreadsheet", { method: "POST", body: fd });
                if (!res.ok) throw new Error("Save failed.");
                const data = await res.json();
                if (!data.success) throw new Error(data.message || "Save failed.");
                await validateSavedWorkbook();
                editor.dirty = false;
                setStatus("Saved ✓");
                if (!auto) toast("Spreadsheet saved.");
            } catch (err) {
                setStatus("Unsaved Changes");
                toast(err.message || "Unable to save spreadsheet.", true);
            } finally {
                editor.saving = false;
            }
        }

        function serializeSpreadsheet() {
            if (isCsvFile()) {
                const csv = sheetToDelimitedText(activeSheet(), editor.csvDelimiter);
                const text = (editor.csvHasBom ? "\uFEFF" : "") + csv;
                return { content: text, contentType: "text/csv;charset=utf-8" };
            }

            return {
                content: XLSX.write(editor.workbook, { bookType: "xlsx", type: "array", cellStyles: true }),
                contentType: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            };
        }

        async function validateSavedWorkbook() {
            const res = await fetch(`/DocumentHub/Preview?fileId=${editor.fileId}&_=${Date.now()}`, { cache: "no-store" });
            if (!res.ok) throw new Error("Save validation failed.");
            const buffer = await res.arrayBuffer();
            if (buffer.byteLength <= 0) throw new Error("Save validation failed.");
        }

        async function saveAndReturn() { await saveWorkbook(false); if (!editor.dirty) location.href = returnUrl(); }
        function backToHub() { if (editor.dirty && !confirm("You have unsaved changes. Leave without saving?")) return; location.href = returnUrl(); }
        function returnUrl() {
            const url = new URL("/DocumentHub/DocumentHubPage", location.origin);
            if (editor.returnFolderId) url.searchParams.set("folderId", editor.returnFolderId);
            if (editor.returnFilter) url.searchParams.set("filter", editor.returnFilter);
            if (editor.returnSearch) url.searchParams.set("search", editor.returnSearch);
            return url.toString();
        }
        function downloadWorkbook() { if (!editor.canDownload) return toast("You do not have permission to download.", true); location.href = `/DocumentHub/Download?fileId=${editor.fileId}`; }
        function refreshWorkbook() { if (editor.dirty && !confirm("Refresh will discard unsaved changes. Continue?")) return; loadWorkbook(); }

        async function toggleVersions(force) {
            const panel = versionPanel;
            const show = force == null ? !panel.classList.contains("show") : force;
            panel.classList.toggle("show", show);
            if (!show) return;
            const res = await fetch(`/DocumentHub/VersionHistory?fileId=${editor.fileId}`);
            const json = await res.json();
            versionRows.innerHTML = (json.data || []).map(v => `
                <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                    <span><strong>v${v.versionNumber}</strong><br><span class="text-muted">${new Date(v.uploadedDate).toLocaleString()}</span></span>
                    ${editor.canRestore ? `<button class="btn btn-sm btn-warning" onclick="restoreVersion(${v.versionNumber})">Restore</button>` : ""}
                </div>`).join("") || "No versions found.";
        }

        async function restoreVersion(versionNumber) {
            if (!editor.canRestore) return toast("You do not have permission to restore versions.", true);
            if (!confirm(`Restore version ${versionNumber}?`)) return;
            const fd = new URLSearchParams({ fileId: editor.fileId, versionNumber });
            const res = await fetch("/DocumentHub/RestoreVersion", { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: fd });
            const json = await res.json();
            if (!json.success) return toast(json.message || "Restore failed.", true);
            editor.dirty = false;
            await loadWorkbook();
            toast("Version restored.");
        }

        function startColResize(e, c) {
            e.preventDefault();
            const startX = e.clientX, startW = editor.colWidths[c] || 120;
            document.onmousemove = ev => { editor.colWidths[c] = Math.max(60, startW + ev.clientX - startX); renderGrid(); };
            document.onmouseup = () => { document.onmousemove = null; document.onmouseup = null; };
        }
        function startRowResize(e, r) {
            e.preventDefault();
            const startY = e.clientY, startH = editor.rowHeights[r] || 28;
            document.onmousemove = ev => { editor.rowHeights[r] = Math.max(22, startH + ev.clientY - startY); renderGrid(); };
            document.onmouseup = () => { document.onmousemove = null; document.onmouseup = null; };
        }
        function normalizeSelection() {
            const s = editor.selection || { start: editor.active, end: editor.active };
            return { r1: Math.min(s.start.r, s.end.r), r2: Math.max(s.start.r, s.end.r), c1: Math.min(s.start.c, s.end.c), c2: Math.max(s.start.c, s.end.c) };
        }
        function expandRef(sheet, r, c) { const range = getRange(sheet); range.e.r = Math.max(range.e.r, r); range.e.c = Math.max(range.e.c, c); sheet["!ref"] = XLSX.utils.encode_range(range); }
        function markDirty() { editor.dirty = true; setStatus("Unsaved Changes"); clearTimeout(editor.autosaveTimer); editor.autosaveTimer = setTimeout(() => saveWorkbook(true), 10000); }
        function setStatus(text) { saveStatus.textContent = text; }
        function toast(message, error) { toastLite.textContent = message; toastLite.style.background = error ? "#dc2626" : "var(--xl-green)"; toastLite.style.display = "block"; setTimeout(() => toastLite.style.display = "none", 2600); }
        function escapeHtml(v) { return String(v ?? "").replace(/[&<>"']/g, ch => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[ch])); }
    </script>
</body>
</html>
