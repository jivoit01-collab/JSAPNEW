@using JSAPNEW.Models
@{
    Layout = null;
    var permissions = ViewBag.DocumentHubPermissions as DocumentHubPermissionDto ?? new DocumentHubPermissionDto();
    var fileId = (int)(ViewBag.FileId ?? 0);
    var fileName = (string)(ViewBag.FileName ?? "Workbook.xlsx");
    var returnFolderId = ViewBag.ReturnFolderId;
    var returnFilter = (string)(ViewBag.ReturnFilter ?? string.Empty);
    var returnSearch = (string)(ViewBag.ReturnSearch ?? string.Empty);
    var fileNameJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(fileName));
    var returnFolderIdJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnFolderId?.ToString() ?? string.Empty));
    var returnFilterJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnFilter));
    var returnSearchJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnSearch));
    var fileTypeJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)(ViewBag.FileType ?? string.Empty)));
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fileName - Document Hub</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <!-- SheetJS: reads/writes the real .xlsx/.csv so Univer stays in sync with the stored file -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

    <!-- Univer (full Excel-like engine) — pinned to 0.25.1 -->
    <script src="https://unpkg.com/react@18.3.1/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/rxjs@7.8.1/dist/bundles/rxjs.umd.min.js"></script>
    <script src="https://unpkg.com/echarts@5.6.0/dist/echarts.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/@@univerjs/preset-sheets-core@0.25.1/lib/index.css" />
    <script src="https://unpkg.com/@@univerjs/presets@0.25.1/lib/umd/index.js"></script>
    <script src="https://unpkg.com/@@univerjs/preset-sheets-core@0.25.1/lib/umd/index.js"></script>
    <script src="https://unpkg.com/@@univerjs/preset-sheets-core@0.25.1/lib/umd/locales/en-US.js"></script>

    <style>
        html, body { height: 100%; margin: 0; }
        .xl-shell { height: 100vh; display: flex; flex-direction: column; font-family: "Segoe UI", Arial, sans-serif; }
        .xl-topbar {
            display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
            padding: 8px 12px; border-bottom: 1px solid #d9e2ec; background: #fff;
        }
        .xl-topbar .btn { border-radius: 6px; font-size: 13px; font-weight: 600; }
        .xl-title { font-weight: 700; max-width: 340px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .xl-status { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; font-size: 12px; color: #64748b; }
        .xl-status-badge { border: 1px solid #d9e2ec; border-radius: 999px; padding: 4px 10px; background: #f8fafc; color: #111827; font-weight: 700; }
        #univerContainer { flex: 1 1 auto; min-height: 0; width: 100%; }
        .xl-version-panel { position: fixed; right: 14px; top: 56px; width: 340px; max-height: 72vh; overflow: auto; z-index: 1200; background: #fff; border: 1px solid #d9e2ec; border-radius: 8px; box-shadow: 0 18px 40px rgba(15,23,42,.16); display: none; }
        .xl-version-panel.show { display: block; }
        .toast-lite { position: fixed; right: 18px; bottom: 18px; z-index: 1300; display: none; padding: 10px 14px; border-radius: 6px; color: #fff; font-weight: 700; background: #107c41; }
        .xl-loading { position: fixed; inset: 0; background: rgba(255,255,255,.9); z-index: 1400; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 12px; color: #475569; font-weight: 600; }
    </style>
</head>
<body>
    <div class="xl-shell">
        <div class="xl-topbar">
            <button class="btn btn-outline-secondary btn-sm" onclick="backToHub()"><i class="fa-solid fa-arrow-left"></i> Back to Document Hub</button>
            <span class="xl-title" title="@fileName"><i class="fa-solid fa-file-excel text-success"></i> @fileName</span>
            <button class="btn btn-success btn-sm" id="saveBtn" onclick="saveWorkbook(false)"><i class="fa-solid fa-floppy-disk"></i> Save</button>
            <button class="btn btn-outline-success btn-sm" onclick="saveAndReturn()"><i class="fa-solid fa-check"></i> Save &amp; Return</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="downloadWorkbook()"><i class="fa-solid fa-download"></i> Download</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="refreshWorkbook()"><i class="fa-solid fa-arrows-rotate"></i> Refresh</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="toggleVersions()"><i class="fa-solid fa-code-branch"></i> Versions</button>
            <span class="xl-status"><span class="xl-status-badge" id="saveStatus">Loading…</span></span>
        </div>
        <div id="univerContainer"></div>
    </div>

    <div class="xl-version-panel" id="versionPanel">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
            <strong>Version History</strong>
            <button class="btn btn-sm btn-light" onclick="toggleVersions(false)"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div id="versionRows" class="p-2 small text-muted">Loading…</div>
    </div>

    <div class="toast-lite" id="toastLite"></div>
    <div class="xl-loading" id="loadingOverlay"><i class="fa-solid fa-spinner fa-spin fa-2x"></i><span>Loading spreadsheet…</span></div>

    <script>
        const editor = {
            fileId: @fileId,
            fileName: @fileNameJson,
            fileType: @fileTypeJson,
            canSave: @permissions.CanUpload.ToString().ToLowerInvariant(),
            canDownload: @permissions.CanDownload.ToString().ToLowerInvariant(),
            canRestore: @permissions.CanRename.ToString().ToLowerInvariant(),
            returnFolderId: @returnFolderIdJson,
            returnFilter: @returnFilterJson,
            returnSearch: @returnSearchJson,
            univer: null,
            univerAPI: null,
            ready: false,
            dirty: false,
            saving: false,
            autosaveTimer: null,
            csvDelimiter: ",",
            csvHasBom: false
        };

        // ---- Univer globals (defensive: names/locations vary slightly across releases) ----
        const Presets = window.UniverPresets || {};
        const UCore = window.UniverCore || window.UniverPresets || {};
        const SheetsCore = window.UniverPresetSheetsCore || {};
        const createUniver = Presets.createUniver;
        const LocaleType = (UCore.LocaleType || Presets.LocaleType || {});
        const mergeLocales = UCore.mergeLocales || Presets.mergeLocales || function (x) { return x; };
        const UniverSheetsCorePreset = SheetsCore.UniverSheetsCorePreset;
        const EnUS = window.UniverPresetSheetsCoreEnUS || {};

        window.addEventListener("beforeunload", e => {
            if (!editor.dirty) return;
            flushSaveBeacon();
            e.preventDefault();
            e.returnValue = "";
        });
        document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "hidden" && editor.dirty) flushSaveBeacon();
        });
        document.addEventListener("keydown", e => {
            if (e.ctrlKey && e.key.toLowerCase() === "s") { e.preventDefault(); saveWorkbook(false); }
        });

        boot();

        async function boot() {
            if (!createUniver || !UniverSheetsCorePreset) {
                setStatus("Editor failed to load");
                overlay(false);
                toast("Spreadsheet engine failed to load (network/CDN blocked).", true);
                return;
            }
            try {
                const data = await loadFileAsUniverData();
                mountUniver(data);
                setStatus("Ready — auto-save on");
                overlay(false);
                editor.ready = true;
                // Fallback autosave sweep
                setInterval(() => { if (editor.dirty) saveWorkbook(true); }, 12000);
            } catch (err) {
                overlay(false);
                setStatus("Load failed");
                toast(err.message || "Spreadsheet failed to load.", true);
            }
        }

        function isCsvFile() {
            const ext = (editor.fileType || editor.fileName.split(".").pop() || "").toLowerCase().replace(".", "");
            return ext === "csv";
        }

        // ---- Load the stored file and convert it into Univer's IWorkbookData ----
        async function loadFileAsUniverData() {
            const res = await fetch(`/DocumentHub/Preview?fileId=${editor.fileId}`, { cache: "no-store" });
            if (!res.ok) throw new Error("Unable to load spreadsheet.");
            if ((res.headers.get("content-type") || "").toLowerCase().includes("text/html"))
                throw new Error("This file is not available in server storage. Restore it from a backup or re-upload it.");

            const buffer = await res.arrayBuffer();
            let wb;
            if (isCsvFile()) {
                const csvText = decodeCsv(buffer);
                editor.csvDelimiter = detectCsvDelimiter(csvText);
                wb = XLSX.read(csvText, { type: "string", raw: false, FS: editor.csvDelimiter });
            } else {
                wb = XLSX.read(buffer, { type: "array", cellDates: false, cellFormula: true });
            }
            return xlsxToUniverData(wb, editor.fileName);
        }

        function xlsxToUniverData(wb, name) {
            const sheets = {};
            const sheetOrder = [];
            (wb.SheetNames.length ? wb.SheetNames : ["Sheet1"]).forEach((sn, i) => {
                const ws = wb.Sheets[sn] || {};
                const ref = ws["!ref"] ? XLSX.utils.decode_range(ws["!ref"]) : { s: { r: 0, c: 0 }, e: { r: 99, c: 25 } };
                const cellData = {};
                Object.keys(ws).forEach(addr => {
                    if (addr[0] === "!") return;
                    const cell = ws[addr];
                    if (cell == null) return;
                    const pos = XLSX.utils.decode_cell(addr);
                    const uCell = {};
                    if (cell.f) uCell.f = "=" + String(cell.f).replace(/^=/, "");
                    if (cell.v != null) uCell.v = cell.v;
                    if (Object.keys(uCell).length === 0) return;
                    (cellData[pos.r] = cellData[pos.r] || {})[pos.c] = uCell;
                });
                const sid = "sheet-" + i;
                sheetOrder.push(sid);
                sheets[sid] = {
                    id: sid,
                    name: (sn || ("Sheet" + (i + 1))).substring(0, 31),
                    rowCount: Math.max(1000, ref.e.r + 100),
                    columnCount: Math.max(60, ref.e.c + 26),
                    cellData
                };
            });
            return { id: "wb-" + editor.fileId + "-" + Date.now(), name: name, appVersion: "0.25.1", locale: "enUS", sheetOrder, sheets, styles: {}, resources: [] };
        }

        function mountUniver(workbookData) {
            disposeUniver();
            const { univer, univerAPI } = createUniver({
                locale: LocaleType.EN_US,
                locales: { [LocaleType.EN_US]: mergeLocales(EnUS) },
                presets: [UniverSheetsCorePreset({ container: "univerContainer" })]
            });
            editor.univer = univer;
            editor.univerAPI = univerAPI;
            univerAPI.createWorkbook(workbookData);

            // Mark dirty when the document actually mutates (ignore selection/scroll operations).
            univerAPI.onCommandExecuted((command) => {
                if (!editor.ready) return;
                if (command && command.type === 2) markDirty(); // 2 = MUTATION
            });
        }

        function disposeUniver() {
            try { if (editor.univer && editor.univer.dispose) editor.univer.dispose(); } catch (e) { }
            editor.univer = null; editor.univerAPI = null;
            const c = document.getElementById("univerContainer");
            if (c) c.innerHTML = "";
        }

        // ---- Read Univer's current state back into a real .xlsx/.csv for saving ----
        function currentSnapshot() {
            const wb = editor.univerAPI && editor.univerAPI.getActiveWorkbook();
            if (!wb) return null;
            if (typeof wb.save === "function") return wb.save();
            if (typeof wb.getSnapshot === "function") return wb.getSnapshot();
            return null;
        }

        function serializeSpreadsheet() {
            const snap = currentSnapshot();
            if (!snap) throw new Error("Nothing to save yet.");
            const wb = univerSnapshotToXlsxWorkbook(snap);
            if (isCsvFile()) {
                const firstSheet = wb.Sheets[wb.SheetNames[0]];
                const csv = XLSX.utils.sheet_to_csv(firstSheet, { FS: editor.csvDelimiter });
                const text = (editor.csvHasBom ? "﻿" : "") + csv;
                return { content: text, contentType: "text/csv;charset=utf-8" };
            }
            return {
                content: XLSX.write(wb, { bookType: "xlsx", type: "array" }),
                contentType: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            };
        }

        function univerSnapshotToXlsxWorkbook(snap) {
            const out = XLSX.utils.book_new();
            const order = (snap.sheetOrder && snap.sheetOrder.length) ? snap.sheetOrder : Object.keys(snap.sheets || {});
            order.forEach((sid, idx) => {
                const sh = snap.sheets[sid];
                if (!sh) return;
                const ws = {};
                let maxR = 0, maxC = 0, any = false;
                const cd = sh.cellData || {};
                Object.keys(cd).forEach(rk => {
                    const row = cd[rk]; const r = +rk;
                    Object.keys(row).forEach(ck => {
                        const cell = row[ck]; const c = +ck;
                        if (cell == null) return;
                        let out2 = null;
                        const f = cell.f ? String(cell.f).replace(/^=/, "") : null;
                        const v = cell.v;
                        if (f) {
                            out2 = { t: typeof v === "number" ? "n" : "s", f };
                            if (v != null) out2.v = v;
                        } else if (v != null && v !== "") {
                            if (typeof v === "number") out2 = { t: "n", v };
                            else if (typeof v === "boolean") out2 = { t: "b", v };
                            else out2 = { t: "s", v: String(v) };
                        }
                        if (out2) { ws[XLSX.utils.encode_cell({ r, c })] = out2; maxR = Math.max(maxR, r); maxC = Math.max(maxC, c); any = true; }
                    });
                });
                ws["!ref"] = XLSX.utils.encode_range({ s: { r: 0, c: 0 }, e: { r: any ? maxR : 0, c: any ? maxC : 0 } });
                const name = (sh.name || ("Sheet" + (idx + 1))).substring(0, 31);
                XLSX.utils.book_append_sheet(out, ws, name);
            });
            if (!out.SheetNames.length) XLSX.utils.book_append_sheet(out, XLSX.utils.aoa_to_sheet([[]]), "Sheet1");
            return out;
        }

        async function saveWorkbook(auto) {
            if (!editor.canSave) return toast("You do not have permission to save this spreadsheet.", true);
            if (editor.saving || (auto && !editor.dirty)) return;
            editor.saving = true;
            setStatus("Saving…");
            try {
                const output = serializeSpreadsheet();
                const fd = new FormData();
                fd.append("fileId", editor.fileId);
                fd.append("workbook", new Blob([output.content], { type: output.contentType }), editor.fileName);
                const res = await fetch("/DocumentHub/SaveSpreadsheet", { method: "POST", body: fd });
                if (!res.ok) throw new Error("Save failed.");
                const data = await res.json();
                if (!data.success) throw new Error(data.message || "Save failed.");
                editor.dirty = false;
                setStatus(`All changes saved ✓ · ${nowTime()}`);
                if (!auto) toast("Spreadsheet saved.");
            } catch (err) {
                setStatus("Unsaved changes");
                toast(err.message || "Unable to save spreadsheet.", true);
            } finally {
                editor.saving = false;
            }
        }

        // Fire-and-forget save when the tab is hidden/closed so edits are never lost.
        function flushSaveBeacon() {
            if (!editor.canSave || !editor.dirty || editor.saving) return;
            try {
                const output = serializeSpreadsheet();
                const fd = new FormData();
                fd.append("fileId", editor.fileId);
                fd.append("workbook", new Blob([output.content], { type: output.contentType }), editor.fileName);
                navigator.sendBeacon("/DocumentHub/SaveSpreadsheet", fd);
            } catch (e) { /* best effort */ }
        }

        async function saveAndReturn() { await saveWorkbook(false); if (!editor.dirty) location.href = returnUrl(); }
        function backToHub() { if (editor.dirty && !confirm("You have unsaved changes. Leave without saving?")) return; location.href = returnUrl(); }
        function returnUrl() {
            const url = new URL("/DocumentHub/DocumentHubPage", location.origin);
            if (editor.returnFolderId) url.searchParams.set("folderId", editor.returnFolderId);
            if (editor.returnFilter) url.searchParams.set("filter", editor.returnFilter);
            if (editor.returnSearch) url.searchParams.set("search", editor.returnSearch);
            return url.toString();
        }
        function downloadWorkbook() { if (!editor.canDownload) return toast("You do not have permission to download.", true); location.href = `/DocumentHub/Download?fileId=${editor.fileId}`; }
        async function refreshWorkbook() {
            if (editor.dirty && !confirm("Refresh will discard unsaved changes. Continue?")) return;
            overlay(true); setStatus("Loading…"); editor.ready = false; editor.dirty = false;
            try {
                const data = await loadFileAsUniverData();
                mountUniver(data);
                setStatus("Ready — auto-save on"); editor.ready = true;
            } catch (err) { toast(err.message || "Reload failed.", true); setStatus("Load failed"); }
            overlay(false);
        }

        async function toggleVersions(force) {
            const panel = versionPanel;
            const show = force == null ? !panel.classList.contains("show") : force;
            panel.classList.toggle("show", show);
            if (!show) return;
            const res = await fetch(`/DocumentHub/VersionHistory?fileId=${editor.fileId}`);
            const json = await res.json();
            versionRows.innerHTML = (json.data || []).map(v => `
                <div class="d-flex justify-content-between align-items-center border-bottom py-2 px-1">
                    <span><strong>v${v.versionNumber}</strong><br><span class="text-muted">${new Date(v.uploadedDate).toLocaleString()}</span></span>
                    ${editor.canRestore ? `<button class="btn btn-sm btn-warning" onclick="restoreVersion(${v.versionNumber})">Restore</button>` : ""}
                </div>`).join("") || "No versions found.";
        }

        async function restoreVersion(versionNumber) {
            if (!editor.canRestore) return toast("You do not have permission to restore versions.", true);
            if (!confirm(`Restore version ${versionNumber}?`)) return;
            const fd = new URLSearchParams({ fileId: editor.fileId, versionNumber });
            const res = await fetch("/DocumentHub/RestoreVersion", { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: fd });
            const json = await res.json();
            if (!json.success) return toast(json.message || "Restore failed.", true);
            editor.dirty = false;
            toggleVersions(false);
            await refreshWorkbook();
            toast("Version restored.");
        }

        // ---- CSV helpers ----
        function decodeCsv(buffer) {
            const bytes = new Uint8Array(buffer);
            editor.csvHasBom = bytes.length >= 3 && bytes[0] === 0xEF && bytes[1] === 0xBB && bytes[2] === 0xBF;
            if (bytes.length >= 2 && bytes[0] === 0xFF && bytes[1] === 0xFE) return new TextDecoder("utf-16le").decode(bytes);
            if (bytes.length >= 2 && bytes[0] === 0xFE && bytes[1] === 0xFF) return new TextDecoder("utf-16be").decode(bytes);
            return new TextDecoder("utf-8").decode(bytes);
        }
        function detectCsvDelimiter(text) {
            const sample = text.split(/\r?\n/).slice(0, 20).join("\n");
            const candidates = [",", ";", "\t", "|"];
            let best = ",", bestScore = -1;
            candidates.forEach(delimiter => {
                const score = sample.split(/\r?\n/).reduce((sum, line) => sum + countDelimiterOutsideQuotes(line, delimiter), 0);
                if (score > bestScore) { bestScore = score; best = delimiter; }
            });
            return best;
        }
        function countDelimiterOutsideQuotes(line, delimiter) {
            let count = 0, quoted = false;
            for (let i = 0; i < line.length; i++) {
                const ch = line[i];
                if (ch === '"' && line[i + 1] === '"') { i++; continue; }
                if (ch === '"') quoted = !quoted;
                else if (!quoted && ch === delimiter) count++;
            }
            return count;
        }

        // ---- misc UI ----
        function markDirty() { editor.dirty = true; setStatus("Editing… auto-save pending"); clearTimeout(editor.autosaveTimer); editor.autosaveTimer = setTimeout(() => saveWorkbook(true), 2500); }
        function nowTime() { return new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" }); }
        function setStatus(text) { document.getElementById("saveStatus").textContent = text; }
        function overlay(show) { document.getElementById("loadingOverlay").style.display = show ? "flex" : "none"; }
        function toast(message, error) { const t = document.getElementById("toastLite"); t.textContent = message; t.style.background = error ? "#dc2626" : "#107c41"; t.style.display = "block"; setTimeout(() => t.style.display = "none", 3000); }
    </script>
</body>
</html>
