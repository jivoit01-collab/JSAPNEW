<style>
    /* ===== PAYMENT CHECKER TABLE: full column values (no "..."), fit-to-text, centered ===== */
    .payment-checker-shell .payment-checker-table-card table.dt.payment-checker-table {
        table-layout: auto !important;
        width: auto !important;
        min-width: 0 !important;
        margin-left: auto;
        margin-right: auto;
    }

    .payment-checker-shell .payment-checker-table-card table.dt.payment-checker-table thead th,
    .payment-checker-shell .payment-checker-table-card table.dt.payment-checker-table tbody td {
        white-space: nowrap;
        overflow: visible;
        text-overflow: clip;
        width: auto !important;
        min-width: 0 !important;
    }

    .payment-checker-shell .payment-checker-table-card table.dt.payment-checker-table .cell-text,
    .payment-checker-shell .payment-checker-table-card table.dt.payment-checker-table .clamp-text {
        max-width: none !important;
        overflow: visible;
        text-overflow: clip;
        white-space: nowrap;
        -webkit-line-clamp: none;
        display: inline;
    }

    .payment-checker-shell .payment-checker-table-card .payment-checker-table col {
        width: auto !important;
        min-width: 0 !important;
    }

    /* keep the account suggestions dropdown above the table card */
    .payment-checker-filter-card {
        position: relative;
        z-index: 40;
    }

    /* the account field is the positioning anchor for its dropdown */
    .payment-checker-filter-card .autocomplete-group {
        position: relative;
    }

    /* ── Account name dropdown (combobox) ── */
    .payment-checker-filter-card .suggestion-box {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        z-index: 3000;
        max-height: 320px;
        overflow-y: auto;
        background: #ffffff;
        border: 1px solid #e5e9f2;
        border-radius: 16px;
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.18);
        padding: 8px;
        display: none;
    }

        .payment-checker-filter-card .suggestion-box:not(:empty) {
            display: block;
        }

        .payment-checker-filter-card .suggestion-box .suggest-item {
            padding: 13px 16px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            color: #1e293b;
            cursor: pointer;
            transition: background .12s ease, color .12s ease;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .payment-checker-filter-card .suggestion-box .suggest-item:hover {
                background: #eff4ff;
                color: #1d4ed8;
            }

            .payment-checker-filter-card .suggestion-box .suggest-item.suggest-empty {
                color: #94a3b8;
                font-weight: 500;
                cursor: default;
                background: transparent;
            }

    .payment-checker-filter-card .suggestion-box::-webkit-scrollbar {
        width: 8px;
    }

    .payment-checker-filter-card .suggestion-box::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 8px;
    }

    /* ── Action column: icon-only square review button ── */
    .payment-checker-shell .td-action {
        text-align: center;
    }

    .payment-checker-shell .btn-review.pc-review-btn {
        width: 34px;
        height: 34px;
        min-width: 0;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        border: none;
        border-radius: 9px;
        cursor: pointer;
        color: #fff;
        font-size: 15px;
        background: linear-gradient(135deg, #16a34a, #22c55e);
        box-shadow: 0 4px 12px rgba(22, 163, 74, .28);
        transition: transform .12s ease, box-shadow .12s ease, filter .12s ease;
    }

        .payment-checker-shell .btn-review.pc-review-btn:hover {
            filter: brightness(1.06);
            transform: translateY(-1px);
            box-shadow: 0 7px 18px rgba(22, 163, 74, .38);
        }

        .payment-checker-shell .btn-review.pc-review-btn:active {
            transform: translateY(0);
        }
</style>

