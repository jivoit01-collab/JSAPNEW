    .removeAttr("href")
    .html('<i class="fa-solid fa-ban"></i> No Attachment');
    }

    $("#verificationModal").css("display", "flex");
    }

    function openRejectPayment()
    {
    if (!currentVoucherNo)
    {
    alert("Voucher not found");
    return;
    }

    if (!confirm("Reject paid entry for voucher " + currentVoucherNo + " (" + (currentPaymentAccountName || "-") + ")?"))
    {
    return;
    }

    const remark = prompt("Enter rejection reason for Maker:", "Payment rejected by payment checker");
    if (remark === null)
    {
    return;
    }

    $.post('/PaymentChecker/RejectPayment',
    {
    vchNumber: currentVoucherNo,
    remark: remark || "Payment rejected by payment checker"
    },
    function(response)
    {
    if(response.success)
    {
    closeVerificationModal();
    alert("Payment rejected and sent back to Maker");
    loadData();
    }
    else
    {
    alert(response.message || "Payment rejection failed");
    }
    }).fail(function()
    {
    alert("Payment rejection failed");
    });
    }

    function closeVerificationModal() {
    $("#verificationModal").hide();
    currentPaymentAccountName = null;
    }

