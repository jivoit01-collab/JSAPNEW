@{
    ViewData["Title"] = "Maker Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/bill-verification.css" />
<link rel="stylesheet" href="~/css/admin-premium.css" />

<style>
    /* ===== MAKER TABLE: show full column names & values (no "..." truncation) ===== */
    .maker-dashboard-shell .maker-table-card table.dt.maker-workflow-table {
        table-layout: auto;
        width: max-content;
        min-width: 100%;
    }

    .maker-dashboard-shell .maker-table-card table.dt.maker-workflow-table thead th,
    .maker-dashboard-shell .maker-table-card table.dt.maker-workflow-table tbody td {
        white-space: nowrap;
        overflow: visible;
        text-overflow: clip;
    }

    .maker-dashboard-shell .maker-table-card table.dt.maker-workflow-table .cell-text {
        max-width: none;
        overflow: visible;
        text-overflow: clip;
        white-space: nowrap;
    }

    /* account name in blue (with expand chevron) */
    .maker-workflow-table .account-drill-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #2563EB;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

        .maker-workflow-table .account-drill-link i {
            font-size: 11px;
            color: #2563EB;
            transition: transform 0.2s ease;
        }

        .maker-workflow-table .account-drill-link.open i {
            transform: rotate(180deg);
        }

    /* action submit button — green square (fresh class, no .btn/.btn-dark pill styling) */
    .maker-dashboard-shell .maker-workflow-table .maker-send {
        width: 34px !important;
        min-width: 34px !important;
        max-width: 34px !important;
        height: 34px !important;
        padding: 0 !important;
        gap: 0 !important;
        margin: 0 auto !important;
        border: 0 !important;
        border-radius: 9px !important;
        background: linear-gradient(135deg, #16a34a, #22c55e) !important;
        box-shadow: 0 8px 16px rgba(34, 197, 94, 0.25) !important;
        color: #fff !important;
        font-size: 14px !important;
        cursor: pointer !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        vertical-align: middle !important;
        float: none !important;
    }

        .maker-dashboard-shell .maker-workflow-table .maker-send:hover {
            filter: brightness(0.96);
        }

    /* center the action button + shrink the ACTION column (less gap before Checker Status) */
    .maker-dashboard-shell .maker-workflow-table td.td-action-cell {
        text-align: center !important;
        padding-left: 6px !important;
        padding-right: 6px !important;
    }

    .maker-dashboard-shell .maker-workflow-table .col-action {
        width: 60px !important;
    }

    /* selected upload file name */
    .maker-workflow-table .chosen-file {
        display: inline-block;
        max-width: 150px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: middle;
        margin-left: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #16a34a;
    }

    /* rejection details modal — centered on the page */
    .reject-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 100000;
        padding: 20px;
    }

        .reject-modal-overlay.open {
            display: flex;
        }

    .reject-modal-box {
        width: min(420px, 100%);
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.30);
        overflow: hidden;
    }

        .reject-modal-box .rip-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(135deg, #dc2626, #ef4444);
            color: #fff;
            font-weight: 700;
            font-size: 15px;
            padding: 14px 18px;
        }

        .reject-modal-box .rip-close {
            background: none;
            border: 0;
            color: #fff;
            font-size: 22px;
            line-height: 1;
            cursor: pointer;
        }

        .reject-modal-box .rip-body {
            padding: 4px 0;
        }

        .reject-modal-box .rip-row {
            display: flex;
            gap: 12px;
            padding: 12px 18px;
            border-bottom: 1px solid #F1F5F9;
            font-size: 14px;
        }

            .reject-modal-box .rip-row:last-child {
                border-bottom: 0;
            }

            .reject-modal-box .rip-row > span {
                min-width: 96px;
                color: #64748b;
                flex: 0 0 auto;
            }

            .reject-modal-box .rip-row > b {
                color: #1f2937;
                font-weight: 600;
                word-break: break-word;
            }

    /* small blue eye to view the checker's rejection remark */
    .maker-workflow-table .reject-remark-eye {
        display: inline-flex;
        align-items: center;
        margin-left: 6px;
        color: #2563EB;
        font-size: 13px;
        text-decoration: none;
        cursor: pointer;
        vertical-align: middle;
    }

    /* keep the account suggestions dropdown above the table card */
    .maker-filter-card {
        position: relative;
        z-index: 40;
    }

    .maker-filter-card .suggestion-box {
        z-index: 3000;
    }

    /* ===== "Columns" toggle button ===== */
    .btn-columns {
        background: #fff;
        color: var(--primary-color, #0b2c4d);
        border: 1px solid #CBD5E1;
        font-weight: 600;
    }

        .btn-columns:hover {
            background: #F1F5F9;
            border-color: var(--primary-color, #0b2c4d);
        }

    /* ===== Right-side column drawer ===== */
    .col-drawer-overlay {
        position: fixed;
        inset: 0;
        background: rgba(11, 44, 77, 0.35);
        display: none;
        z-index: 1400;
    }

        .col-drawer-overlay.open {
            display: block;
        }

    .col-drawer {
        position: fixed;
        top: var(--header-height, 60px);
        right: 0;
        height: calc(100vh - var(--header-height, 60px));
        width: 320px;
        max-width: 85vw;
        background: #fff;
        box-shadow: -8px 0 30px rgba(11, 44, 77, 0.18);
        transform: translateX(100%);
        transition: transform 0.25s ease, visibility 0.25s ease;
        z-index: 1401;
        display: flex;
        flex-direction: column;
        visibility: hidden;
        pointer-events: none;
    }

        .col-drawer.open {
            transform: translateX(0);
            visibility: visible;
            pointer-events: auto;
        }

    .col-drawer-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 18px;
        background: linear-gradient(135deg, var(--primary-color, #0b2c4d) 0%, var(--primary-light, #1c3f5d) 100%);
        color: #fff;
        font-weight: 700;
    }

    .col-drawer-close {
        background: none;
        border: 0;
        color: #fff;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
    }

    .col-drawer-note {
        padding: 12px 18px 4px;
        font-size: 12px;
        color: #64748B;
    }

    .col-drawer-tools {
        display: flex;
        gap: 8px;
        padding: 10px 18px 6px;
        border-bottom: 1px solid #E2E8F0;
    }

    .col-tool-btn {
        flex: 1;
        border: 1px solid var(--primary-color, #0b2c4d);
        background: #fff;
        color: var(--primary-color, #0b2c4d);
        border-radius: 6px;
        padding: 7px 10px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.2s ease;
    }

        .col-tool-btn:hover {
            background: var(--primary-color, #0b2c4d);
            color: #fff;
        }

    .col-drawer-body {
        padding: 6px 18px 18px;
        overflow-y: auto;
    }

    /* template bar */
    .col-drawer-tpl {
        padding: 12px 18px;
        border-bottom: 1px solid #E2E8F0;
        background: #F8FBFF;
    }

    .col-tpl-label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: var(--primary-color, #0b2c4d);
        margin-bottom: 6px;
    }

    .col-tpl-select {
        width: 100%;
        padding: 7px 10px;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        font-size: 13px;
        color: #1F2937;
        background: #fff;
        margin-bottom: 8px;
    }

    .col-tpl-actions {
        display: flex;
        gap: 6px;
    }

    /* column row: checkbox + label + move arrows */
    .col-check {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px;
        border-bottom: 1px solid #F1F5F9;
        font-size: 14px;
        color: #1F2937;
        border-radius: 6px;
        transition: background 0.15s ease;
    }

        .col-check:hover {
            background: #EFF3F8;
        }

    .col-check-label {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
        min-width: 0;
        cursor: pointer;
    }

        .col-check-label span {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .col-check-label input {
            width: 16px;
            height: 16px;
            accent-color: var(--primary-color, #0b2c4d);
            cursor: pointer;
            flex: 0 0 auto;
        }

    .col-move {
        display: flex;
        gap: 4px;
        flex: 0 0 auto;
    }

    .col-move-btn {
        border: 1px solid #E2E8F0;
        background: #fff;
        color: var(--primary-color, #0b2c4d);
        border-radius: 5px;
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 11px;
        transition: all 0.15s ease;
    }

        .col-move-btn:hover:not(:disabled) {
            background: var(--primary-color, #0b2c4d);
            color: #fff;
        }

        .col-move-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }
</style>

<!-- PREMIUM CONTENT -->
<div class="admin-dashboard-shell maker-dashboard-shell">
    <nav class="premium-nav">
        <div class="nav-glass">
            <div class="nav-left-section">
                <div class="brand-logo-wrap">
                    <img src="~/images/logo.png" class="brand-logo" alt="Akal Rozgar Yojana logo" />
                </div>
                <div class="brand-content">
                    <div class="ary-brand-header">Akal Rozgar Yojana A U/O JWPL</div>
                    <div class="brand-title">Maker Upload Desk</div>
                    <div class="brand-subtitle">Bill attachments • Remarks • Resubmission workflow</div>
                </div>
            </div>

            <div class="product-slider" aria-label="Product showcase">
                <div class="product-track">
                    <img src="@Url.Content("~/images/canola.jpg")" class="product-img clickable-product" alt="Canola oil" />
                    <img src="@Url.Content("~/images/js3.png")" class="product-img clickable-product" alt="Juice product" />
                    <img src="@Url.Content("~/images/Pomace-2-1000x1000.png")" class="product-img clickable-product" alt="Pomace oil" />
                    <img src="@Url.Content("~/images/Desi-Ghee.jpg")" class="product-img clickable-product" alt="Desi ghee" />
                    <img src="@Url.Content("~/images/download.jpg")" class="product-img" alt="Wellness product" />
                </div>
            </div>

            <div class="module-box maker">
                <span class="module-dot"></span>
                <i class="fa-solid fa-pen-to-square"></i>
                <span>Maker Dashboard</span>
            </div>
        </div>
    </nav>

    <!-- BODY -->
    <div class="body admin-dashboard-body">

        <!-- PRODUCT MODAL -->
        <div class="product-modal" id="productModal">
            <span class="close-modal">&times;</span>
            <img id="modalImage" class="modal-product-image" />
        </div>

        <!-- =====================================================
             MAKER KPI CARDS
        ====================================================== -->
        <div class="kpi-grid">

            <!-- TOTAL ATTACHMENTS -->
            <div class="kpi-card k-blue">

                <div class="kpi-top">
                    <div>
                        <div class="kpi-val"
                             id="cardTotalAttachments">
                            0
                        </div>
                        <div class="kpi-label">
                            Total Attachments
                        </div>
                    </div>
                    <div class="kpi-icon">
                        <i class="fa-solid fa-paperclip"></i>
                    </div>
                </div>
                <div class="kpi-bottom">
                    <svg class="kpi-wave" viewBox="0 0 80 28" fill="none">
                        <polyline points="0,20 12,14 24,18 36,8 48,14 60,6 72,12 80,8"
                                  stroke="#3B82F6" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <div class="kpi-trend"><i class="fa-solid fa-folder-open fa-xs"></i> Total</div>
                </div>
            </div>


            <!-- PENDING -->
            <div class="kpi-card k-amber">

                <div class="kpi-top">
                    <div>
                        <div class="kpi-val"
                             id="cardPending">
                            0
                        </div>
                        <div class="kpi-label">
                            Pending Entries
                        </div>
                    </div>
                    <div class="kpi-icon">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                </div>
                <div class="kpi-bottom">
                    <svg class="kpi-wave" viewBox="0 0 80 28" fill="none">
                        <polyline points="0,12 12,18 24,10 36,20 48,12 60,18 72,8 80,14"
                                  stroke="#F59E0B" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <div class="kpi-trend"><i class="fa-solid fa-hourglass-half fa-xs"></i> Awaiting</div>
                </div>
            </div>


            <!-- SUBMITTED -->
            <div class="kpi-card k-green">

                <div class="kpi-top">
                    <div>
                        <div class="kpi-val"
                             id="cardSubmitted">
                            0
                        </div>
                        <div class="kpi-label">
                            Submitted Entries
                        </div>
                    </div>
                    <div class="kpi-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
                <div class="kpi-bottom">
                    <svg class="kpi-wave" viewBox="0 0 80 28" fill="none">
                        <polyline points="0,18 12,10 24,16 36,7 48,13 60,5 72,12 80,8"
                                  stroke="#22C55E" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <div class="kpi-trend"><i class="fa-solid fa-check fa-xs"></i> Uploaded</div>
                </div>
            </div>


            <!-- REJECTED -->
            <div class="kpi-card k-purple">

                <div class="kpi-top">
                    <div>
                        <div class="kpi-val"
                             id="cardRejected">
                            0
                        </div>
                        <div class="kpi-label">
                            Rejected Entries
                        </div>
                    </div>
                    <div class="kpi-icon">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </div>
                </div>
                <div class="kpi-bottom">
                    <svg class="kpi-wave" viewBox="0 0 80 28" fill="none">
                        <polyline points="0,20 12,12 24,18 36,10 48,18 60,8 72,15 80,9"
                                  stroke="#8B5CF6" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <div class="kpi-trend"><i class="fa-solid fa-rotate-right fa-xs"></i> Needs Action</div>
                </div>
            </div>
        </div>

        <!-- GLOBAL FILTER -->
        <div class="filter-card maker-filter-card">
            <div class="f-group">
                <span class="f-label">From Date</span>
                <input type="date" class="f-input" id="fromDate" />
            </div>
            <div class="f-group">
                <span class="f-label">To Date</span>
                <input type="date" class="f-input" id="toDate" />
            </div>
            <div class="f-group grow autocomplete-group">
                <span class="f-label">Account Name</span>
                <input type="text" class="f-input" id="accountName" placeholder="Search vendor..." />
                <div id="suggestionBox" class="suggestion-box"></div>
            </div>

            <div class="f-group">
                <span class="f-label">Entry Type</span>
                <select id="entryFilter" class="f-input">
                    <option value="all">All Entries</option>
                    <option value="submitted">Submitted</option>
                    <option value="notsubmitted">Not Submitted</option>
                </select>
            </div>

            <div class="f-group">
                <span class="f-label">Due Date</span>
                <select id="dueFilter" class="f-input">
                    <option value="">All</option>
                    <option value="overdue">Overdue</option>
                    <option value="today">Due Today</option>
                    <option value="upcoming">Upcoming</option>
                </select>
            </div>

            <button class="btn btn-dark admin-search-btn" onclick="loadData()">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>

            <button class="btn btn-columns" id="columnsBtn" type="button">
                <i class="fa-solid fa-table-columns"></i> Columns
            </button>

            <button class="btn btn-export" onclick="exportToExcel()" id="exportBtn" style="display:none">
                <i class="fa-solid fa-file-excel"></i> Export
            </button>
        </div>


        <!-- TABLE CARD -->
        <div class="t-card maker-table-card">

            <div class="t-header">
                <div>
                    <span class="t-title">
                        <i class="fa-solid fa-list-check"></i> My Entries
                    </span>
                    <div class="t-subtitle">Upload bills, update remarks, and track checker feedback</div>
                </div>
                <span class="t-count" id="maker-count">0 records</span>
            </div>

            <div class="top-scroll">
                <div class="top-scroll-inner"></div>
            </div>

            <div class="t-wrap">
                <table class="dt maker-workflow-table">
                    <colgroup>
                        <col class="col-account" />
                        <col class="col-voucher" />
                        <col class="col-date" />
                        <col class="col-amount" />
                        <col class="col-supplier" />
                        <col class="col-date" />
                        <col class="col-date" />
                        <col class="col-attachment" />
                        <col class="col-action" />
                        <col class="col-status" />
                        <col class="col-qty" />
                        <col class="col-value" />
                        <col class="col-items" />
                        <col class="col-payment-status" />
                        <col class="col-date" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Account Name</th>
                            <th>MRN</th>
                            <th>MRN Date</th>
                            <th>Bill Amount</th>
                            <th>Supplier Ref</th>
                            <th> Ref Date</th>
                            <th>Due Date</th>
                            <th>Attachment</th>
                            <th>Action</th>
                            <th>Checker Status</th>
                            <th>Total Qty</th>
                            <th>Total Value</th>
                            <th>Total Items</th>
                            <th>Payment Status</th>
                            <th>Payment Date</th>
                        </tr>
                    </thead>
                    <tbody id="makerBody"></tbody>
                </table>
            </div>

            <!-- PAGINATION (10 per page) -->
            <div class="dt-pagination" id="pg-mk">
                <div class="dt-pg-info">Showing <b id="mk-from">0</b>–<b id="mk-to">0</b> of <b id="mk-total">0</b></div>
                <div class="dt-pg-btns" id="pg-btns-mk"></div>
            </div>

        </div>

        <!-- SCROLL BUTTONS -->
        <div id="scroll-btns">
            <button class="scroll-btn"
                    onclick="window.scrollTo({top:0,behavior:'smooth'})"
                    title="Scroll to Top">
                <i class="fa-solid fa-chevron-up"></i>
            </button>
            <button class="scroll-btn"
                    onclick="window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'})"
                    title="Scroll to Bottom">
                <i class="fa-solid fa-chevron-down"></i>
            </button>
        </div>

        <!-- PDF MODAL -->
        <div id="pdfContainer" class="pdf-modal">
            <div class="pdf-box">
                <button onclick="closePdf()" class="pdf-close">
                    ×
                </button>
                <iframe id="pdfFrame"></iframe>
            </div>
        </div>

        <!-- COLUMN TOGGLE DRAWER -->
        <div class="col-drawer-overlay" id="colDrawerOverlay"></div>
        <aside class="col-drawer" id="colDrawer" aria-hidden="true">
            <div class="col-drawer-head">
                <span><i class="fa-solid fa-table-columns"></i> Columns &amp; Templates</span>
                <button type="button" class="col-drawer-close" id="colDrawerClose">&times;</button>
            </div>

            <div class="col-drawer-tpl">
                <label class="col-tpl-label" for="colTplSelect">Template</label>
                <select id="colTplSelect" class="col-tpl-select"></select>
                <div class="col-tpl-actions">
                    <button type="button" class="col-tool-btn" id="colTplSaveAs"><i class="fa-solid fa-plus"></i> Save as</button>
                    <button type="button" class="col-tool-btn" id="colTplUpdate"><i class="fa-solid fa-pen"></i> Update</button>
                    <button type="button" class="col-tool-btn" id="colTplDelete"><i class="fa-solid fa-trash"></i> Delete</button>
                </div>
            </div>

            <div class="col-drawer-note">Reorder with the arrows, uncheck to hide, then save your view as a template.</div>
            <div class="col-drawer-tools">
                <button type="button" class="col-tool-btn" id="colSelectAll"><i class="fa-solid fa-check-double"></i> Select all</button>
                <button type="button" class="col-tool-btn" id="colClearAll"><i class="fa-regular fa-square"></i> Clear all</button>
            </div>
            <div class="col-drawer-body" id="colDrawerBody"></div>
        </aside>

    </div><!-- /.body -->
</div><!-- /.maker-dashboard-shell -->


<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>

    /* ═══════════════════════════════════
    BOOT
    ═══════════════════════════════════ */
    let makerDataCache = [];

    /* pagination state — 10 rows per page */
    let mkRows = [];
    let mkPage = 1;
    const mkPerPage = 10;

    $(document).ready(function () {

        /* default both dates to today, then auto-load today's data (if any) */
        (function () {
            const t = new Date();
            const today = t.getFullYear() + "-" +
                String(t.getMonth() + 1).padStart(2, "0") + "-" +
                String(t.getDate()).padStart(2, "0");
            $("#fromDate").val(today);
            $("#toDate").val(today);
        })();
        loadData();

        /* search button */
        /*  $("#searchBtn").click(loadData);*/

        /* account name — omni search + click-to-open dropdown (combobox) */
        function loadMakerAccountSuggestions() {
            const searchText = $("#accountName").val().trim();
            $.get("/Maker/GetAccountSuggestions", { term: searchText }, function (data) {
                makerDataCache = data || [];

                let html = "";
                if (!data || data.length === 0) {
                    html = `<div class="suggest-item suggest-empty">No result</div>`;
                } else {
                    data.forEach(x => {
                        html += `<div class="suggest-item">${x}</div>`;
                    });
                }

                $("#suggestionBox").html(html).show();
            });
        }

        /* open list on focus/click (shows options even before typing) and filter while typing */
        $("#accountName").on("focus click keyup", loadMakerAccountSuggestions);

        /* suggestion click — select item */
        $(document).on("mousedown", ".suggest-item", function (e) {
            e.preventDefault();
            if ($(this).hasClass("suggest-empty")) return;
            $("#accountName").val($(this).text().trim());
            $("#suggestionBox").empty().hide();
        });

        /* hide suggestion box on outside click */
        $(document).on("click", function (e) {
            if (!$(e.target).closest("#accountName, #suggestionBox").length) {
                $("#suggestionBox").empty().hide();
            }
        });

    });

    /* ═══════════════════════════════════
    LOAD DATA  (your original logic — unchanged)
    ═══════════════════════════════════ */
    function loadData() {

        let fromDate    = $("#fromDate").val();
        let toDate      = $("#toDate").val();
        let accountName = $("#accountName").val().trim() || null;

        if (!fromDate || !toDate) {
            alert("Select both dates");
            return;
        }

        if (fromDate > toDate) {
            alert("From Date cannot be greater than To Date");
            return;
        }

        $("#makerBody").html(`<tr><td colspan="15" style="text-align:center;padding:30px;color:#9CA3AF">Loading...</td></tr>`);
        resetMakerKPIs();

        $.get("/Maker/GetBillDetails",
            { fromDate, toDate, accountName },
            function (data) {
                renderTable(data || []);

                updateMakerKPIs(data || []);
            }
        ).fail(function () {
            $("#makerBody").html(`<tr><td colspan="15" style="text-align:center;padding:30px;color:#EF4444">Error loading data. Please try again.</td></tr>`);
        });
    }

    function safeText(value) {
        if (value === null || value === undefined || value === "") return "-";
        return $("<div>").text(value).html();
    }

    function safeAttr(value) {
        return safeText(value).replace(/"/g, "&quot;");
    }

    function safeValueAttr(value) {
        if (value === null || value === undefined) return "";
        return $("<div>").text(value).html().replace(/"/g, "&quot;");
    }

    function safeJsString(value) {
        return JSON.stringify(value || "").replace(/&/g, "&amp;").replace(/"/g, "&quot;");
    }

    /* ═══════════════════════════════════
    RENDER TABLE  (your original logic + improved UI)
    ═══════════════════════════════════ */
    function renderTable(data) {

        if (!data || data.length === 0) {
            $("#exportBtn").hide();
        } else {
            $("#exportBtn").show();
        }

        let seenVch = new Set();
        let entryType =
            $("#entryFilter").val();
        let dueFilter =
            $("#dueFilter").val();

        let today =
            new Date();

        today.setHours(0,0,0,0);

        let rows = [];
        (data || [])
            .filter(item => item.paymentStatus !== "Paid")
            .forEach(item => {

                /* hide approved */
                if ((item.checkerStatus || "").toLowerCase() === "approved") {
                    return;
                }

                /* show rejected for re-upload */
                if ((item.checkerStatus || "").toLowerCase() === "rejected") {
                    // allow rejected entries
                }
                else {
                    /* hide submitted pending entries */
                    if (item.attachmentPath) {
                        return;
                    }
                }

                if (seenVch.has(item.vchNumber)) return;
                seenVch.add(item.vchNumber);

                let isSubmitted =
                    !!item.attachmentPath;

                if (
                    entryType === "submitted" &&
                    !isSubmitted
                )
                    return;

                if (
                    entryType === "notsubmitted" &&
                    isSubmitted
                )
                    return;

                /* DUE DATE FILTER */
                if (dueFilter && item.dueDate) {

                    let dueDate =
                        new Date(item.dueDate);

                    dueDate.setHours(0,0,0,0);

                    if (
                        dueFilter === "overdue"
                        &&
                        !(dueDate < today)
                    ) {
                        return;
                    }

                    if (
                        dueFilter === "today"
                        &&
                        dueDate.getTime() !== today.getTime()
                    ) {
                        return;
                    }

                    if (
                        dueFilter === "upcoming"
                        &&
                        !(dueDate > today)
                    ) {
                        return;
                    }
                }

                rows.push(item);
            });

        mkRows = rows;
        mkPage = 1;
        /* count badge = records actually shown in the table (after filters) */
        $("#maker-count").text(mkRows.length + " record" + (mkRows.length !== 1 ? "s" : ""));
        renderMkPage();
    }

    function mkRowHtml(item) {
        /* checker status — pill with text; rejected shows an eye to view the remark */
        let checkerStatusValue = item.checkerStatus || "Pending";
        let statusBadge =
            checkerStatusValue === "Approved" ? `<span class="status-badge sb-approved"><i class="fa-solid fa-check"></i> Approved</span>` :
            checkerStatusValue === "Rejected" ? `<span class="status-badge sb-rejected"><i class="fa-solid fa-xmark"></i> Rejected</span>
                <a href="javascript:void(0)" class="reject-remark-eye" title="View rejection details"
                   onclick="showRejectInfo(this, ${safeJsString(item.checkerRemark || '')}, ${safeJsString(item.checkerName || '')}, ${safeJsString(item.checkerBy || '')}, ${safeJsString(item.checkerDate || '')}); return false;"><i class="fa-solid fa-eye"></i></a>` :
            `<span class="status-badge sb-pending"><i class="fa-solid fa-clock"></i> Pending</span>`;

        /* payment badge — pill with text */
        let payBadge = item.paymentStatus === "Paid"
            ? `<span class="status-badge sb-approved"><i class="fa-solid fa-circle-check"></i> Paid</span>`
            : `<span class="status-badge sb-pending"><i class="fa-regular fa-clock"></i> Unpaid</span>`;

        /* attachment cell — View / Upload buttons (like the checker page) */
        let attachCell =
            item.checkerStatus === "Approved"
                ? `<span class="status-badge sb-approved"><i class="fa-solid fa-check"></i> Approved</span>`
                : `<div class="attach-group">
                    ${item.attachmentPath ?
                        `<a class="attach-view"
                            href="#"
                            onclick="openPdf(${safeJsString(item.attachmentPath)}); return false;">
                            <i class="fa-solid fa-eye"></i> View
                        </a>`
                        : ''}
                    <label class="upload-zone ${item.attachmentPath ? 'reupload-zone' : ''}">
                        <i class="fa-solid fa-rotate-right"></i>
                        ${item.attachmentPath ? 'Re-Upload' : 'Upload'}
                        <input type="file"
                            class="fileInput"
                            accept=".pdf,.jpg,.jpeg,.png">
                    </label>
                    <span class="chosen-file"></span>
                </div>`;

        // remark cell
        // let remarkCell = item.attachmentPath
        // ? `<span class="cell-text clamp-text">${safeText(item.makerRemark || "-")}</span>`
        // : `<input type="text" class="remarkInput f-input maker-remark-input" placeholder="Enter remark">`;

        /* action cell */
        let actionCell =
            item.checkerStatus === "Approved"
                ? `<span class="status-badge sb-approved">
                    <i class="fa-solid fa-lock"></i> Locked
                </span>`
                : `<button class="submitBtn maker-send"
                    data-vch="${safeValueAttr(item.vchNumber)}"
                    title="${item.attachmentPath ? 'Update' : 'Submit'}">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>`;

        return `
            <tr id="maker-row-${safeValueAttr(item.vchNumber)}">
                <td class="td-account" title="${safeAttr(item.accountName || '')}">
                    <a href="javascript:void(0)" class="account-drill-link" onclick="toggleMakerDetails('${safeValueAttr(item.vchNumber)}', this)">
                        <span class="cell-text">${safeText(item.accountName || "")}</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </a>
                </td>
                <td class="td-voucher"><span class="cell-text">${safeText(item.vchNumber || "")}</span></td>
                <td class="td-date"><span class="cell-text">${safeText(formatDate(item.voucherDate))}</span></td>
                <td class="td-amount"><span class="cell-text">&#8377;${safeText(item.billAmount || "")}</span></td>
                <td class="td-supplier" title="${safeAttr(item.supplierRef || '-')}"><span class="cell-text">${safeText(item.supplierRef || "-")}</span></td>
                <td class="td-date"><span class="cell-text">${safeText(item.supplierRefDate ? formatDate(item.supplierRefDate) : "-")}</span></td>
                <td class="td-date"><span class="cell-text">${safeText(item.dueDate ? formatDate(item.dueDate) : "-")}</span></td>
                <td class="td-attachment">${attachCell}</td>
                <td class="td-action-cell">${actionCell}</td>
                <td class="td-status">${statusBadge}</td>
                <td class="td-number"><span class="cell-text">${safeText(item.totalQuantity ?? 0)}</span></td>
                <td class="td-number"><span class="cell-text">${safeText(item.totalItemValue ?? 0)}</span></td>
                <td class="td-number"><span class="cell-text">${safeText(item.totalItems ?? 0)}</span></td>
                <td class="td-status">${payBadge}</td>
                <td class="td-date"><span class="cell-text">${safeText(item.paymentDate ? formatDate(item.paymentDate) : "-")}</span></td>
            </tr>`;
    }

    function renderMkPage() {
        if (mkRows.length === 0) {
            $("#makerBody").html(
                `<tr><td colspan="15" class="empty-row">
                    <i class="fa-solid fa-inbox" style="font-size:22px;display:block;margin-bottom:8px;color:#D1D5DB"></i>
                    No data found for the selected filters.
                </td></tr>`
            );
            $("#mk-from").text(0);
            $("#mk-to").text(0);
            $("#mk-total").text(0);
            $("#pg-btns-mk").empty();
            return;
        }

        const total = mkRows.length;
        const start = (mkPage - 1) * mkPerPage;
        const end   = Math.min(start + mkPerPage, total);

        let html = "";
        mkRows.slice(start, end).forEach(item => { html += mkRowHtml(item); });
        $("#makerBody").html(html);

        $("#mk-from").text(total ? start + 1 : 0);
        $("#mk-to").text(end);
        $("#mk-total").text(total);

        renderMkPagination(total);

        if (window._applyMakerColumnLayout) window._applyMakerColumnLayout();
        if (window._syncTopScroll) window._syncTopScroll();
    }

    function renderMkPagination(total) {
        const pages = Math.ceil(total / mkPerPage);
        const box = $("#pg-btns-mk");
        box.empty();
        if (pages <= 1) return;

        box.append(`<button class="dt-pg-btn"${mkPage === 1 ? ' disabled' : ''} onclick="mkGoPage(${mkPage - 1})"><i class="fa-solid fa-chevron-left fa-xs"></i></button>`);

        mkPageNums(mkPage, pages).forEach(p => {
            if (p === '...') box.append('<span class="dt-pg-dots">…</span>');
            else box.append(`<button class="dt-pg-btn${p === mkPage ? ' active' : ''}" onclick="mkGoPage(${p})">${p}</button>`);
        });

        box.append(`<button class="dt-pg-btn"${mkPage === pages ? ' disabled' : ''} onclick="mkGoPage(${mkPage + 1})"><i class="fa-solid fa-chevron-right fa-xs"></i></button>`);
    }

    function mkPageNums(current, total) {
        if (total <= 7) { let a = []; for (let i = 1; i <= total; i++) a.push(i); return a; }
        let p = [1];
        if (current > 3) p.push('...');
        let lo = Math.max(2, current - 1), hi = Math.min(total - 1, current + 1);
        for (let j = lo; j <= hi; j++) p.push(j);
        if (current < total - 2) p.push('...');
        p.push(total);
        return p;
    }

    function mkGoPage(p) {
        mkPage = p;
        renderMkPage();
        window.scrollTo({ top: document.querySelector('.maker-table-card')?.offsetTop || 0, behavior: 'smooth' });
    }

    /* ═══════════════════════════════════
    ROW DETAILS  (click account chevron → show invoice items below, incl. MRP)
    ═══════════════════════════════════ */
    function toggleMakerDetails(vchNumber, linkEl) {
        const existing = document.getElementById("maker-details-" + vchNumber);
        if (existing) {
            existing.remove();
            if (linkEl) linkEl.classList.remove("open");
            return;
        }

        /* close any other open detail row */
        document.querySelectorAll("[id^='maker-details-']").forEach(el => el.remove());
        document.querySelectorAll(".maker-workflow-table .account-drill-link.open").forEach(el => el.classList.remove("open"));

        const row = document.getElementById("maker-row-" + vchNumber);
        if (!row) return;
        if (linkEl) linkEl.classList.add("open");

        row.insertAdjacentHTML("afterend", `
            <tr id="maker-details-${vchNumber}" class="detail-row">
                <td colspan="15" class="erp-detail-cell">
                    <div class="detail-inner" style="padding:14px;color:#6B7280"><i class="fa-solid fa-spinner fa-spin"></i> Loading items...</div>
                </td>
            </tr>`);

        fetch("/Maker/GetInvoiceItems?vchNumber=" + vchNumber)
            .then(r => { if (!r.ok) throw new Error(); return r.json(); })
            .then(data => {
                const items = Array.isArray(data) ? data : [];
                /* MRP serialises as "mRP" (System.Text.Json camelCase of MRP) — read defensively */
                const mrpOf = it => (it.mRP ?? it.mrp ?? it.MRP ?? 0);
                const rateOf = it => (it.taxRate ?? it.tax ?? 0);

                let totalQty = 0, totalAmount = 0;
                items.forEach(it => {
                    totalQty += Number(it.quantity) || 0;
                    totalAmount += Number(it.amount) || 0;
                });

                const bodyRows = items.length
                    ? items.map((it, idx) => `
                        <tr class="erp-item-row">
                            <td class="erp-product">${safeText(it.productName ?? "-")}</td>
                            <td class="erp-qty">${safeText(it.quantity ?? 0)}</td>
                            <td class="erp-rate">&#8377;${safeText(it.purchaseRate ?? 0)}</td>
                            <td class="erp-disc">${safeText(it.discountPercent ?? 0)}%</td>
                            <td class="erp-margin">${safeText(it.margin ?? 0)}%</td>
                            <td class="erp-taxrate">${safeText(rateOf(it))}%</td>
                            <td class="erp-mrp">&#8377;${safeText(mrpOf(it))}</td>
                            <td class="erp-amount">&#8377;${safeText(it.amount ?? 0)}</td>
                            <td class="erp-sno">${safeText(it.serialNumber ?? idx + 1)}</td>
                        </tr>`).join("") + `
                        <tr style="background:#f8fafc;font-weight:700;border-top:2px solid #ccc;">
                            <td>TOTAL</td>
                            <td>${totalQty.toFixed(2)}</td>
                            <td colspan="5"></td>
                            <td>&#8377;${totalAmount.toFixed(2)}</td>
                            <td></td>
                        </tr>`
                    : `<tr><td colspan="9" class="erp-empty">No items found.</td></tr>`;

                const el = document.getElementById("maker-details-" + vchNumber);
                if (el) {
                    el.querySelector("td").innerHTML = `
                        <div class="erp-detail-wrap">
                            <table class="erp-detail-table">
                                <thead>
                                    <tr>
                                        <th class="erp-product">Product Name</th>
                                        <th class="erp-qty">Qty</th>
                                        <th class="erp-rate">Pur. Rate</th>
                                        <th class="erp-disc">Disc %</th>
                                        <th class="erp-margin">Margin %</th>
                                        <th class="erp-taxrate">Tax Rate</th>
                                        <th class="erp-mrp">MRP</th>
                                        <th class="erp-amount">Amount</th>
                                        <th class="erp-sno">Serial No</th>
                                    </tr>
                                </thead>
                                <tbody>${bodyRows}</tbody>
                            </table>
                        </div>`;
                }
            })
            .catch(() => {
                const el = document.getElementById("maker-details-" + vchNumber);
                if (el) el.querySelector("td").innerHTML = `<div class="detail-inner" style="color:#EF4444">Error loading items.</div>`;
            });
    }

