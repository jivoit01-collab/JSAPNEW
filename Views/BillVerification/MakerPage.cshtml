    /* ═══════════════════════════════════
    KPI UPDATE
    ═══════════════════════════════════ */
    function updateMakerKPIs(data) {

        if (!data || data.length === 0) {
            resetMakerKPIs();
            return;
        }

        let total =
            new Set(
                data.map(x => x.vchNumber)
            ).size;
        let pending =
            new Set(
                data
                    .filter(x => !x.attachmentPath)
                    .map(x => x.vchNumber)
            ).size;

        let submitted =
            new Set(
                data
                    .filter(x => x.attachmentPath)
                    .map(x => x.vchNumber)
            ).size;

        let rejected =
            data.filter(x =>
                (x.checkerStatus || "")
                    .toLowerCase() === "rejected"
            ).length;

        $("#cardTotalAttachments").text(total);
        $("#cardPending").text(pending);
        $("#cardSubmitted").text(submitted);
        $("#cardRejected").text(rejected);
    }

    function exportToExcel() {
        if (!makerDataCache || !makerDataCache.length) {
            showToast("No data to export", "error"); return;
        }

        var fromDate = $("#fromDate").val() || "all";
        var toDate   = $("#toDate").val()   || "";
        var filename = "maker-entries_" + fromDate + (toDate ? "_to_" + toDate : "") + ".csv";

        var rows = [];
        rows.push([
            "Account Name","Voucher No","Voucher Date","Bill Amount",
            "Supplier Ref","Supplier Ref Date","Due Date",
            ,"Checker Status",
            "Total Qty","Total Value","Total Items",
            "Payment Status","Payment Date"
        ]);

        var seenVch = new Set();
        makerDataCache.forEach(function(item) {
            if (seenVch.has(item.vchNumber)) return;
            seenVch.add(item.vchNumber);
            rows.push([
                item.accountName      || "",
                item.vchNumber        || "",
                formatDate(item.voucherDate)      || "",
                item.billAmount       || "",
                item.supplierRef      || "",
                formatDate(item.supplierRefDate)  || "",
                formatDate(item.dueDate)          || "",
                item.makerRemark      || "",
                item.checkerStatus    || "Pending",
                item.totalQuantity    != null ? item.totalQuantity  : "",
                item.totalItemValue   != null ? item.totalItemValue : "",
                item.totalItems       != null ? item.totalItems     : "",
                item.paymentStatus    || "",
                formatDate(item.paymentDate)      || ""
            ]);
        });

        var totalAmt = makerDataCache.reduce(function(s,x){ return s+(parseFloat(x.billAmount)||0);},0);
        var totalQty = makerDataCache.reduce(function(s,x){ return s+(parseFloat(x.totalQuantity)||0);},0);
        var totalVal = makerDataCache.reduce(function(s,x){ return s+(parseFloat(x.totalItemValue)||0);},0);
        var totalItm = makerDataCache.reduce(function(s,x){ return s+(parseFloat(x.totalItems)||0);},0);

        rows.push([]);
        rows.push(["TOTALS","","","₹"+totalAmt.toLocaleString("en-IN"),"","","","","",totalQty,totalVal,totalItm,"",""]);

        downloadCSV(rows, filename);
        showToast("Exported successfully!", "success");
    }

    /* ═══════════════════════════════════════
    SHARED CSV EXPORT UTILITY
    Add once per page — handles all escaping,
    BOM, and clean formatting.
    ═══════════════════════════════════════ */
    function downloadCSV(rows, filename) {
        var BOM = "\uFEFF"; // UTF-8 BOM — ensures Excel opens with correct encoding
        var csv = BOM + rows.map(function(row) {
            return row.map(function(cell) {
                var v = (cell === null || cell === undefined) ? "" : String(cell);
                // Normalise whitespace — remove line breaks, collapse spaces
                v = v.replace(/[\r\n\t]+/g, " ").replace(/\s{2,}/g, " ").trim();
                // Escape double-quotes
                v = v.replace(/"/g, '""');
                // Always quote every cell for safety
                return '"' + v + '"';
            }).join(",");
        }).join("\r\n");

        var blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
        var url  = URL.createObjectURL(blob);
        var a    = document.createElement("a");
        a.href     = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }

    /* ═══════════════════════════════════
    COLUMNS + TEMPLATES  (right-side drawer)
    show / hide, reorder (shift), and saved named templates
    ═══════════════════════════════════ */
    (function () {
        const table     = document.querySelector('.maker-workflow-table');
        const drawer    = document.getElementById('colDrawer');
        const overlay   = document.getElementById('colDrawerOverlay');
        const body      = document.getElementById('colDrawerBody');
        const btn       = document.getElementById('columnsBtn');
        const tplSelect = document.getElementById('colTplSelect');
        if (!table || !drawer || !overlay || !body || !btn || !tplSelect) return;

        const LS_KEY   = 'makerColumnTemplates_v1';
        const thead    = table.querySelector('thead tr');
        const colgroup = table.querySelector('colgroup');
        const ths      = Array.prototype.slice.call(thead.children);
        const TOTAL    = ths.length;

        /* remember each column's original position + label; tag persistent cells */
        const labels = [];
        ths.forEach(function (th, i) { th.dataset.key = i; labels[i] = th.textContent.trim() || ('Column ' + (i + 1)); });
        if (colgroup) Array.prototype.slice.call(colgroup.children).forEach(function (col, i) { col.dataset.key = i; });

        function defaultState() { return labels.map(function (_, i) { return { key: i, visible: true }; }); }

        /* columnState = display order + visibility, e.g. [{key:0,visible:true}, ...] */
        let columnState = defaultState();

        /* ---------- storage ---------- */
        function loadStore() {
            try { return JSON.parse(localStorage.getItem(LS_KEY)) || { templates: {}, active: null }; }
            catch (e) { return { templates: {}, active: null }; }
        }
        function saveStore(s) { localStorage.setItem(LS_KEY, JSON.stringify(s)); }

        /* make a stored state valid for the current columns (drops unknown, appends new) */
        function normalizeState(state) {
            if (!Array.isArray(state)) return defaultState();
            const seen = {}, result = [];
            state.forEach(function (c) {
                if (c && typeof c.key === 'number' && c.key >= 0 && c.key < TOTAL && !seen[c.key]) {
                    seen[c.key] = true;
                    result.push({ key: c.key, visible: c.visible !== false });
                }
            });
            for (let i = 0; i < TOTAL; i++) if (!seen[i]) result.push({ key: i, visible: true });
            return result;
        }

        function snapshot() { return columnState.map(function (c) { return { key: c.key, visible: c.visible }; }); }

        /* ---------- apply order + visibility to the DOM ---------- */
        function orderByKey(container) {
            const map = {};
            Array.prototype.slice.call(container.children).forEach(function (el) { map[el.dataset.key] = el; });
            columnState.forEach(function (c) {
                const el = map[c.key];
                if (!el) return;
                el.style.display = c.visible ? '' : 'none';
                container.appendChild(el);
            });
        }
        /* tag a freshly-rendered row's cells once (rows render in original order) */
        function ensureRowTagged(row) {
            if (row.children.length !== TOTAL) return false; // skip detail / colspan rows
            if (row.dataset.colTagged === '1') return true;
            Array.prototype.slice.call(row.children).forEach(function (cell, i) { cell.dataset.key = i; });
            row.dataset.colTagged = '1';
            return true;
        }
        function applyLayout() {
            orderByKey(thead);
            if (colgroup) orderByKey(colgroup);
            const tb = table.querySelector('tbody');
            if (tb) Array.prototype.slice.call(tb.children).forEach(function (row) {
                if (ensureRowTagged(row)) orderByKey(row);
            });
            if (window._syncTopScroll) window._syncTopScroll();
        }
        /* expose so the pagination page-renderer can re-apply layout on fresh rows */
        window._applyMakerColumnLayout = applyLayout;

        /* re-apply order/visibility every time the table body is re-rendered */
        const tbody = table.querySelector('tbody');
        if (tbody && typeof MutationObserver !== 'undefined') {
            new MutationObserver(function () { applyLayout(); }).observe(tbody, { childList: true });
        }

        /* ---------- drawer list ---------- */
        function renderDrawer() {
            let html = '';
            columnState.forEach(function (c, pos) {
                html += `<div class="col-check" data-key="${c.key}">
                    <label class="col-check-label">
                        <input type="checkbox" ${c.visible ? 'checked' : ''}>
                        <span>${labels[c.key]}</span>
                    </label>
                    <span class="col-move">
                        <button type="button" class="col-move-btn" data-dir="up" ${pos === 0 ? 'disabled' : ''} title="Move up"><i class="fa-solid fa-chevron-up"></i></button>
                        <button type="button" class="col-move-btn" data-dir="down" ${pos === columnState.length - 1 ? 'disabled' : ''} title="Move down"><i class="fa-solid fa-chevron-down"></i></button>
                    </span>
                </div>`;
            });
            body.innerHTML = html;
        }

        function findIndexByKey(key) { return columnState.findIndex(function (c) { return c.key === key; }); }

        /* toggle visibility */
        body.addEventListener('change', function (e) {
            if (!e.target.matches('input[type=checkbox]')) return;
            const key = parseInt(e.target.closest('.col-check').dataset.key, 10);
            const item = columnState[findIndexByKey(key)];
            if (item) { item.visible = e.target.checked; applyLayout(); }
        });

        /* reorder (shift up / down) */
        body.addEventListener('click', function (e) {
            const moveBtn = e.target.closest('.col-move-btn');
            if (!moveBtn) return;
            const key  = parseInt(moveBtn.closest('.col-check').dataset.key, 10);
            const idx  = findIndexByKey(key);
            const swap = moveBtn.getAttribute('data-dir') === 'up' ? idx - 1 : idx + 1;
            if (swap < 0 || swap >= columnState.length) return;
            const t = columnState[idx]; columnState[idx] = columnState[swap]; columnState[swap] = t;
            renderDrawer();
            applyLayout();
        });

        /* select all / clear all */
        function setAllColumns(state) {
            columnState.forEach(function (c) { c.visible = state; });
            renderDrawer();
            applyLayout();
        }
        document.getElementById('colSelectAll').addEventListener('click', function () { setAllColumns(true); });
        document.getElementById('colClearAll').addEventListener('click', function () { setAllColumns(false); });

        /* ---------- templates ---------- */
        function refreshTemplateOptions(selectedName) {
            const store = loadStore();
            let opts = '<option value="">— Default (all columns) —</option>';
            Object.keys(store.templates).forEach(function (name) {
                const safe = name.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
                opts += `<option value="${safe}"${name === selectedName ? ' selected' : ''}>${safe}</option>`;
            });
            tplSelect.innerHTML = opts;
            tplSelect.value = selectedName || '';
        }
        function applyState(state) { columnState = normalizeState(state); renderDrawer(); applyLayout(); }

        tplSelect.addEventListener('change', function () {
            const name  = tplSelect.value;
            const store = loadStore();
            store.active = name || null;
            saveStore(store);
            applyState(name && store.templates[name] ? store.templates[name] : defaultState());
        });

        document.getElementById('colTplSaveAs').addEventListener('click', function () {
            const name = (prompt('Save current column layout as template. Enter a name:') || '').trim();
            if (!name) return;
            const store = loadStore();
            store.templates[name] = snapshot();
            store.active = name;
            saveStore(store);
            refreshTemplateOptions(name);
            showToast('Template "' + name + '" saved.', 'success');
        });

        document.getElementById('colTplUpdate').addEventListener('click', function () {
            const name = tplSelect.value;
            if (!name) { showToast('Select a template first, or use "Save as".', 'error'); return; }
            const store = loadStore();
            store.templates[name] = snapshot();
            store.active = name;
            saveStore(store);
            showToast('Template "' + name + '" updated.', 'success');
        });

        document.getElementById('colTplDelete').addEventListener('click', function () {
            const name = tplSelect.value;
            if (!name) { showToast('Select a template to delete.', 'error'); return; }
            if (!confirm('Delete template "' + name + '"?')) return;
            const store = loadStore();
            delete store.templates[name];
            if (store.active === name) store.active = null;
            saveStore(store);
            refreshTemplateOptions('');
            applyState(defaultState());
            showToast('Template deleted.', 'success');
        });

        /* ---------- open / close ---------- */
        function openDrawer()  { drawer.classList.add('open');    overlay.classList.add('open'); }
        function closeDrawer() { drawer.classList.remove('open'); overlay.classList.remove('open'); }
        btn.addEventListener('click', openDrawer);
        document.getElementById('colDrawerClose').addEventListener('click', closeDrawer);
        overlay.addEventListener('click', closeDrawer);

        /* ---------- init: auto-apply last used template ---------- */
        (function init() {
            const store = loadStore();
            refreshTemplateOptions(store.active || '');
            columnState = (store.active && store.templates[store.active])
                ? normalizeState(store.templates[store.active])
                : defaultState();
            renderDrawer();
            applyLayout();
        })();
    })();
</script>
