    /* rejection details modal (eye icon on a Rejected row) — who / when / reason */
    function fmtRejectDate(v) {
        if (!v) return "—";
        const d = new Date(v);
        if (isNaN(d)) return String(v);
        return d.toLocaleString();
    }

    function showRejectInfo(el, remark, name, by, date) {
        /* ensure only ONE overlay ever exists — remove any leftover, then build fresh on <body> */
        const old = document.getElementById("rejectInfoOverlay");
        if (old) old.remove();

        const overlay = document.createElement("div");
        overlay.id = "rejectInfoOverlay";
        overlay.className = "reject-modal-overlay";
        overlay.innerHTML = '<div class="reject-modal-box" id="rejectInfoBox"></div>';
        document.body.appendChild(overlay);

        /* click on the dark backdrop (not the box) closes it */
        overlay.addEventListener("click", function (e) {
            if (e.target === overlay) hideRejectInfo();
        });
        /* Esc closes it */
        document.addEventListener("keydown", function onEsc(e) {
            if (e.key === "Escape") { hideRejectInfo(); document.removeEventListener("keydown", onEsc); }
        });

        const s = v => (v === null || v === undefined) ? "" : String(v).trim();
        const who  = s(name) ? (s(name) + (s(by) ? ` (ID: ${s(by)})` : ""))
                             : (s(by) ? `ID: ${s(by)}` : "—");
        const when = s(date) ? fmtRejectDate(date) : "—";
        const why  = s(remark) ? s(remark) : "No reason provided";

        document.getElementById("rejectInfoBox").innerHTML =
            `<div class="rip-head">
                <span><i class="fa-solid fa-circle-xmark"></i> Rejection Details</span>
                <button type="button" class="rip-close" onclick="hideRejectInfo()">&times;</button>
            </div>
            <div class="rip-body">
                <div class="rip-row"><span>Rejected by</span><b>${safeText(who)}</b></div>
                <div class="rip-row"><span>Rejected on</span><b>${safeText(when)}</b></div>
                <div class="rip-row"><span>Reason</span><b>${safeText(why)}</b></div>
            </div>`;

        overlay.classList.add("open");
    }

    function hideRejectInfo() {
        const overlay = document.getElementById("rejectInfoOverlay");
        if (overlay) overlay.remove();
    }

    /* ═══════════════════════════════════
    SHOW SELECTED FILE NAME (after choosing a file to upload)
    ═══════════════════════════════════ */
    $(document).on("change", ".fileInput", function () {
        const name = (this.files && this.files.length) ? this.files[0].name : "";
        const label = $(this).closest(".attach-group").find(".chosen-file");
        label.text(name).attr("title", name);
    });

    /* ═══════════════════════════════════
    SUBMIT BUTTON  (your original logic — unchanged)
    ═══════════════════════════════════ */
    $(document).on("click", ".submitBtn", function () {

        let row       = $(this).closest("tr");
        let vchNumber = $(this).data("vch");
        let fileInput = row.find(".fileInput")[0];
        let remark    = row.find(".remarkInput").val();

        /* ATTACHMENT IS MANDATORY — without a file the bill cannot move to the next (Checker) stage */
        if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
            showToast("Attachment is mandatory. Please upload the bill file before submitting.", "error");
            let zone = row.find(".upload-zone");
            zone.css({ "outline": "2px solid #EF4444", "outline-offset": "2px" });
            setTimeout(() => zone.css({ "outline": "", "outline-offset": "" }), 2000);
            return;
        }

        /* only allow valid bill formats and reject empty files */
        let file    = fileInput.files[0];
        let nameOk  = /\.(pdf|jpe?g|png)$/i.test(file.name);
        if (!nameOk) {
            showToast("Only PDF, JPG or PNG files are allowed.", "error");
            return;
        }
        if (!file.size) {
            showToast("The selected file is empty. Please choose a valid bill file.", "error");
            return;
        }

        let btn      = $(this);
        let origText = btn.html();
        btn.html('<i class="fa-solid fa-spinner fa-spin"></i> Uploading…').prop('disabled', true);

        let formData = new FormData();
        formData.append("vchNumber",   vchNumber);
        formData.append("file",        fileInput.files[0]);
        formData.append("makerRemark", remark);

        $.ajax({
            url:         "/Maker/SubmitBill",
            type:        "POST",
            data:        formData,
            contentType: false,
            processData: false,
            success: function (res) {
                if (res.success) {
                    showToast("Uploaded successfully", "success");
                    loadData();
                } else {
                    btn.html(origText).prop('disabled', false);
                    showToast("Upload failed. Please try again.", "error");
                }
            },
            error: function () {
                btn.html(origText).prop('disabled', false);
                showToast("An error occurred. Please try again.", "error");
            }
        });
    });

    /* ═══════════════════════════════════
    TOAST
    ═══════════════════════════════════ */
    function showToast(msg, type) {
        const t = document.createElement('div');
        t.className   = 'toast toast-' + type;
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(() => t.classList.add('toast-show'), 10);
        setTimeout(() => {
            t.classList.remove('toast-show');
            setTimeout(() => t.remove(), 300);
        }, 3000);
    }

