    </td>
    <td class="erp-qty">${safeText(item.quantity ?? 0)}</td>
    <td class="erp-rate">₹${safeText(item.purchaseRate ?? 0)}</td>
    <td class="erp-disc">${safeText(item.discountPercent ?? 0)}%</td>
    <td class="erp-margin">${safeText(item.margin ?? 0)}%</td>
    <td class="erp-taxrate">${safeText(item.taxRate ?? 0)}%</td>
    <td class="erp-taxamount">₹${safeText(item.taxAmount ?? 0)}</td>
    <td class="erp-mrp">₹${safeText(item.mRP ?? item.mrp ?? item.MRP ?? 0)}</td>
    <td class="erp-amount">₹${safeText(item.amount ?? 0)}</td>
