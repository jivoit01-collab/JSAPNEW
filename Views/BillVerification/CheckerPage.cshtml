<div class="body admin-dashboard-body">
    <!-- KPI CARDS -->
    <div class="kpi-grid">

        <div class="kpi-card k-amber">
            <div class="kpi-top">
                <div>
                    <div class="kpi-val" id="pendingCount">0</div>
                    <div class="kpi-label">Pending Approvals</div>
                </div>
                <div class="kpi-icon">
                    <i class="fa-solid fa-clock"></i>
                </div>
            </div>
            <div class="kpi-bottom">
                <svg class="kpi-wave" viewBox="0 0 80 28" fill="none">
                    <polyline points="0,10 12,18 24,12 36,20 48,10 60,16 72,8 80,14"
                              stroke="#F59E0B" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="kpi-trend"><i class="fa-solid fa-hourglass-half fa-xs"></i> Awaiting</div>
            </div>
        </div>

        <div class="kpi-card k-green">
            <div class="kpi-top">
                <div>
                    <div class="kpi-val" id="approvedToday">0</div>
                    <div class="kpi-label">Approved</div>
                </div>
                <div class="kpi-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>
            <div class="kpi-bottom">
                <svg class="kpi-wave" viewBox="0 0 80 28" fill="none">
                    <polyline points="0,18 12,10 24,16 36,6 48,14 60,4 72,10 80,6"
                              stroke="#22C55E" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="kpi-trend"><i class="fa-solid fa-check fa-xs"></i> Verified</div>
            </div>
        </div>

        <div class="kpi-card k-blue">
            <div class="kpi-top">
                <div>
                    <div class="kpi-val" id="monthlyEntries">0</div>
                    <div class="kpi-label">Total Entries</div>
                </div>
                <div class="kpi-icon">
                    <i class="fa-solid fa-file-invoice"></i>
                </div>
            </div>
            <div class="kpi-bottom">
                <svg class="kpi-wave" viewBox="0 0 80 28" fill="none">
                    <polyline points="0,22 12,14 24,18 36,8 48,16 60,6 72,12 80,8"
                              stroke="#3B82F6" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="kpi-trend"><i class="fa-solid fa-arrow-trend-up fa-xs"></i> All Entries</div>
            </div>
        </div>

        <div class="kpi-card k-purple">
            <div class="kpi-top">
                <div>
                    <div class="kpi-val" id="rejectedToday">0</div>
                    <div class="kpi-label">Rejected</div>
                </div>
                <div class="kpi-icon">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>
            </div>
            <div class="kpi-bottom">
                <svg class="kpi-wave" viewBox="0 0 80 28" fill="none">
                    <polyline points="0,20 12,12 24,18 36,8 48,18 60,10 72,14 80,8"
                              stroke="#8B5CF6" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="kpi-trend"><i class="fa-solid fa-ban fa-xs"></i> Returned</div>
            </div>
        </div>

    </div>

    <!-- PDF VIEWER -->
    <div id="pdfContainer" class="pdf-modal">
        <div class="pdf-box">
            <button onclick="closePdf()" class="pdf-close">×</button>
            <iframe id="pdfFrame"></iframe>
        </div>
    </div>

    <!-- ═══════════════════════════════════
         FILTER CARD
    ═══════════════════════════════════ -->
    <div class="filter-card checker-filter-card">
        <div class="f-group">
            <span class="f-label">From Date</span>
            <input type="date" id="fromDate" class="f-input" />
        </div>
        <div class="f-group">
            <span class="f-label">To Date</span>
            <input type="date" id="toDate" class="f-input" />
        </div>
        <div class="f-group grow autocomplete-group">
            <span class="f-label">Account Name</span>
            <input type="text" id="accountName" class="f-input"
                   placeholder="Search account..." autocomplete="off" />
            <div id="suggestionBox" class="suggestion-box"></div>
        </div>
        <div class="f-group">
            <span class="f-label">Status</span>
            <select id="statusFilter" class="f-input">
                <option value="">All Status</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </select>
        </div>
        <button class="btn btn-dark admin-search-btn" id="searchBtn">
            <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
        <button class="btn btn-columns" id="columnsBtn" type="button">
            <i class="fa-solid fa-table-columns"></i> Columns
        </button>
        <button class="btn btn-export" onclick="exportToExcel()" id="exportBtn" style="display:none">
            <i class="fa-solid fa-file-excel"></i> Export
        </button>
    </div>

    <!-- ═══════════════════════════════════
         TABLE CARD
    ═══════════════════════════════════ -->
    <div class="t-card checker-table-card">
        <div class="t-header">
            <span class="t-title">
                <i class="fa-solid fa-shield-check"></i> Bill Verification
            </span>
            <span class="t-count" id="checkerCount">0 records</span>
        </div>

        <!-- TOP HORIZONTAL SCROLLBAR -->
        <div class="top-scroll" id="topScroll">
            <div class="top-scroll-inner" id="topScrollInner"></div>
        </div>

        <div class="t-wrap" id="tableWrap">
                <table class="dt dt-checker checker-workflow-table" id="checkerDt">
                <colgroup>
                    <col class="col-account" />
                        <col class="col-MRN" />
                    <col class="col-date" />
                    <col class="col-amount" />
                    <col class="col-supplier" />
                    
                    <col class="col-attachment" />
                   
                    <col class="col-status" />
                    <col class="col-checker-remark" />
                    <col class="col-action" />
                        <col class="col-date" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Account</th>
                        <th>MRN</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Supplier Ref</th>
                
                        <th>Attachment</th>

                        <th>Status</th>
                        <th>Checker Remark</th>
                        <th>Action</th>
                         <th>Due Date</th>
                    </tr>
                </thead>
                <tbody id="checkerTable"></tbody>
            </table>
        </div>

        <!-- PAGINATION (10 per page) -->
        <div class="dt-pagination" id="pg-ck">
            <div class="dt-pg-info">Showing <b id="ck-from">0</b>–<b id="ck-to">0</b> of <b id="ck-total">0</b></div>
            <div class="dt-pg-btns" id="pg-btns-ck"></div>
        </div>

    </div>

    <!-- SCROLL BUTTONS -->
    <div id="scroll-btns">
        <button class="scroll-btn" onclick="window.scrollTo({top:0,behavior:'smooth'})" title="Top">
            <i class="fa-solid fa-chevron-up"></i>
        </button>
        <button class="scroll-btn" onclick="window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'})" title="Bottom">
            <i class="fa-solid fa-chevron-down"></i>
        </button>
    </div>

    <!-- COLUMN TOGGLE DRAWER -->
    <div class="col-drawer-overlay" id="colDrawerOverlay"></div>
    <aside class="col-drawer" id="colDrawer" aria-hidden="true">
        <div class="col-drawer-head">
            <span><i class="fa-solid fa-table-columns"></i> Columns &amp; Templates</span>
            <button type="button" class="col-drawer-close" id="colDrawerClose">&times;</button>
        </div>

        <div class="col-drawer-tpl">
            <label class="col-tpl-label" for="colTplSelect">Template</label>
            <select id="colTplSelect" class="col-tpl-select"></select>
            <div class="col-tpl-actions">
                <button type="button" class="col-tool-btn" id="colTplSaveAs"><i class="fa-solid fa-plus"></i> Save as</button>
                <button type="button" class="col-tool-btn" id="colTplUpdate"><i class="fa-solid fa-pen"></i> Update</button>
                <button type="button" class="col-tool-btn" id="colTplDelete"><i class="fa-solid fa-trash"></i> Delete</button>
            </div>
        </div>

        <div class="col-drawer-note">Reorder with the arrows, uncheck to hide, then save your view as a template.</div>
        <div class="col-drawer-tools">
            <button type="button" class="col-tool-btn" id="colSelectAll"><i class="fa-solid fa-check-double"></i> Select all</button>
            <button type="button" class="col-tool-btn" id="colClearAll"><i class="fa-regular fa-square"></i> Clear all</button>
        </div>
        <div class="col-drawer-body" id="colDrawerBody"></div>
    </aside>

</div><!-- /.body -->
<!-- ═══════════════════════════════════
     CONFIRMATION MODAL
═══════════════════════════════════ -->
<div class="confirm-overlay" id="confirmOverlay">
    <div class="confirm-box" id="confirmBox">

        <div class="confirm-header">
            <div class="confirm-icon" id="confirmIcon">
                <i id="confirmIconSymbol" class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <div class="confirm-title" id="confirmTitle">Confirm Action</div>
                <div class="confirm-subtitle" id="confirmSubtitle">Please review before proceeding</div>
            </div>
        </div>

        <div class="confirm-body">
            <div class="confirm-warning" id="confirmWarning">
                <i id="confirmWarnIcon" class="fa-solid fa-triangle-exclamation"></i>
                <div id="confirmWarningText">Are you sure?</div>
            </div>
            <div class="confirm-meta" id="confirmMeta">
                <div class="confirm-meta-row">
                    <span>MRN</span>
                    <span id="meta-vch">—</span>
                </div>
                <div class="confirm-meta-row">
                    <span>Account Name</span>
                    <span id="meta-account">—</span>
                </div>
                <div class="confirm-meta-row">
                    <span>Amount</span>
                    <span id="meta-amount">—</span>
                </div>
                <div class="confirm-meta-row">
                    <span>Checker Remark</span>
                    <span id="meta-remark">—</span>
                </div>
            </div>
        </div>

        <div class="confirm-footer">
            <button class="confirm-cancel" id="confirmCancel">
                <i class="fa-solid fa-xmark"></i> Cancel
            </button>
            <button class="confirm-proceed" id="confirmProceed">
                <i class="fa-solid fa-check"></i> Confirm
            </button>
        </div>

    </div>
</div>
</div><!-- /.checker-dashboard-shell -->

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>

    /* ═══════════════════════════════════════
    STATE
    ═══════════════════════════════════════ */
    let _pendingAction = null;   // function to call on confirm
    let _checkerDataCache = [];

    /* pagination state — 10 rows per page */
    let ckRows = [];
    let ckPage = 1;
    const ckPerPage = 10;

    /* ═══════════════════════════════════════
    BOOT
    ═══════════════════════════════════════ */
    $(document).ready(function () {

    $("#searchBtn").on("click", loadData);

    /* default both dates to today, then auto-load today's data */
    (function () {
    const t = new Date();
    const today = t.getFullYear() + "-" +
    String(t.getMonth() + 1).padStart(2, "0") + "-" +
    String(t.getDate()).padStart(2, "0");
    $("#fromDate").val(today);
    $("#toDate").val(today);
    })();
    loadData();

    /* autocomplete — omni search + click-to-open dropdown (combobox) */
    function loadCheckerAccountSuggestions() {
    const term = $("#accountName").val().trim();
    $.get("/Checker/GetAccountSuggestions", { term }, function (data) {
    if (!data || !data.length) {
    $("#suggestionBox").html('<div class="suggest-item suggest-empty">No result</div>').show();
    return;
    }
    let html = "";
    data.forEach(x => { html += `<div class="suggest-item">${x}</div>`; });
    $("#suggestionBox").html(html).show();
    });
    }

    /* open list on focus/click (shows options even before typing) and filter while typing */
    $("#accountName").on("focus click keyup", loadCheckerAccountSuggestions);

    $(document).on("mousedown", ".suggest-item", function (e) {
    e.preventDefault();
    const v = $(this).text().trim();
    if (v !== "No result") $("#accountName").val(v);
    $("#suggestionBox").empty().hide();
    });

    $(document).on("click", function (e) {
    if (!$(e.target).closest("#accountName, #suggestionBox").length)
    $("#suggestionBox").empty().hide();
    });

    /* modal — cancel */
    $("#confirmCancel").on("click", closeConfirm);

    /* modal — confirm */
    $("#confirmProceed").on("click", function () {
    if (typeof _pendingAction === "function") {
    _pendingAction();
    }
    });

    /* ESC to close modal */
    $(document).on("keydown", function (e) {
    if (e.key === "Escape") closeConfirm();
    });

    /* click OUTSIDE confirm-box = do NOT close (safety) */

    initScrollSync();
    });

    /* ═══════════════════════════════════════
    LOAD DATA
    ═══════════════════════════════════════ */
    function loadData() {
    const fromDate    = $("#fromDate").val();
    const toDate      = $("#toDate").val();
    const accountName = $("#accountName").val().trim() || null;
    const status      = $("#statusFilter").val();

    $("#checkerTable").html(
    `<tr><td colspan="10" class="empty-row">
    <i class="fa-solid fa-spinner fa-spin" style="font-size:20px;color:#9CA3AF"></i>
    </td></tr>`
    );

    $.get("/Checker/GetBillDetails",
    { fromDate: fromDate || null, toDate: toDate || null, accountName, status },
    function (data) {
    renderTable(data || []);
    _checkerDataCache = data || [];
    updateCheckerKPIs(data || []);
    }
    ).fail(function () {
    $("#exportBtn").hide();
    $("#checkerTable").html(
    `<tr><td colspan="10" class="empty-row" style="color:#EF4444">
    <i class="fa-solid fa-triangle-exclamation"></i> Error loading data.
    </td></tr>`
    );
    });
    }
    function updateCheckerKPIs(data) {

    if (!data || data.length === 0) {

    $("#pendingCount").text("0");

    $("#approvedToday").text("0");

    $("#monthlyEntries").text("0");

    $("#rejectedToday").text("0");

    return;
    }

    /* unique vouchers */

    const uniqueRows = [
    ...new Map(
    data.map(x => [x.vchNumber, x])
    ).values()
    ];

    /* only bills that actually reached the checker (uploaded, not paid) —
       keeps the KPI cards consistent with what the table shows */
    const relevant = uniqueRows.filter(x =>
    x.attachmentPath &&
    (x.paymentStatus || "").toLowerCase() !== "paid"
    );

    /* pending (these are exactly the rows shown in the table) */

    const pending =
    relevant.filter(x =>
    (x.checkerStatus || "Pending")
    .toLowerCase() === "pending"
    ).length;

    /* approved */

    const approved =
    relevant.filter(x =>
    (x.checkerStatus || "")
    .toLowerCase() === "approved"
    ).length;

    /* rejected */

    const rejected =
    relevant.filter(x =>
    (x.checkerStatus || "")
    .toLowerCase() === "rejected"
    ).length;

    /* total bills that reached the checker */

    const total =
    relevant.length;

    $("#pendingCount").text(pending);

    $("#approvedToday").text(approved);

    $("#monthlyEntries").text(total);

    $("#rejectedToday").text(rejected);

    }

    function safeText(value) {
    if (value === null || value === undefined || value === "") return "-";
    return $("<div>").text(value).html();
    }

    function safeAttr(value) {
    return safeText(value).replace(/"/g, "&quot;");
    }

    function safeValueAttr(value) {
    if (value === null || value === undefined) return "";
    return $("<div>").text(value).html().replace(/"/g, "&quot;");
    }

    function toInvoiceNumber(value) {
    if (value === null || value === undefined || value === "") return 0;
    const normalized = String(value).replace(/[₹,\s%]/g, "");
    const numberValue = Number(normalized);
    return Number.isFinite(numberValue) ? numberValue : 0;
    }

    function roundInvoiceAmount(value) {
    return Math.round((Number(value) || 0) * 100) / 100;
    }

    function formatInvoiceAmount(value) {
    return roundInvoiceAmount(value).toFixed(2);
    }

    function getTaxableValue(item) {
    const direct = toInvoiceNumber(item.itemValue ?? item.amount);
    if (direct) return direct;

    const quantity = toInvoiceNumber(item.quantity);
    const rate = toInvoiceNumber(item.purchaseRate);
    const discountAmount = toInvoiceNumber(item.discountAmount);
    return Math.max(0, (quantity * rate) - discountAmount);
    }

    function buildGstTaxSummary(items) {
    const groups = new Map();

    (items || []).forEach(item => {
    const rate = roundInvoiceAmount(toInvoiceNumber(item.taxRate ?? item.tax));
    const key = rate.toFixed(2);
    const taxable = getTaxableValue(item);
    const taxNameRaw = String(item.taxName || "").trim();
    const taxName = taxNameRaw && taxNameRaw !== "-"
    ? taxNameRaw
    : (rate === 0 ? "Input GST 0%" : `Input GST ${formatInvoiceAmount(rate).replace(/\.00$/, "")}% (Excl)`);
    const calculatedTax = taxable * rate / 100;
    const itemTax = toInvoiceNumber(item.taxAmount) || calculatedTax;
    const isIgst = /igst/i.test(taxNameRaw);

    if (!groups.has(key)) {
    groups.set(key, { rate, taxName, taxable: 0, cgst: 0, sgst: 0, igst: 0 });
    }

    const group = groups.get(key);
    group.taxable += taxable;
    if (isIgst) {
    group.igst += itemTax;
    } else {
    group.cgst += itemTax / 2;
    group.sgst += itemTax / 2;
    }
    });

    const rows = Array.from(groups.values()).sort((a, b) => b.rate - a.rate);
    const total = rows.reduce((sum, row) => ({
    taxable: sum.taxable + row.taxable,
    cgst: sum.cgst + row.cgst,
    sgst: sum.sgst + row.sgst,
    igst: sum.igst + row.igst
    }), { taxable: 0, cgst: 0, sgst: 0, igst: 0 });

    const body = rows.length
    ? rows.map(row => `
    <tr>
    <td class="tax-name">${safeText(row.taxName)}</td>
    <td>₹${formatInvoiceAmount(row.taxable)}</td>
    <td>₹${formatInvoiceAmount(row.cgst)}</td>
    <td>₹${formatInvoiceAmount(row.sgst)}</td>
    <td>₹${formatInvoiceAmount(row.igst)}</td>
    </tr>`).join("")
    : `<tr><td colspan="5" class="erp-empty">No tax summary found.</td></tr>`;

    return `
    <div class="erp-tax-summary-wrap">
    <div class="erp-tax-summary-title">Tax Summary</div>
    <table class="erp-tax-summary-table">
    <thead>
    <tr>
    <th>Tax Name</th>
    <th>Taxable Value</th>
    <th>CGST</th>
    <th>SGST</th>
    <th>IGST</th>
    </tr>
    </thead>
    <tbody>
    ${body}
    <tr class="grand-total">
    <td>Grand Total</td>
    <td>₹${formatInvoiceAmount(total.taxable)}</td>
    <td>₹${formatInvoiceAmount(total.cgst)}</td>
    <td>₹${formatInvoiceAmount(total.sgst)}</td>
    <td>₹${formatInvoiceAmount(total.igst)}</td>
    </tr>
    </tbody>
    </table>
    </div>`;
    }

    /* render table */
    function renderTable(data) {


    const seen = new Set();
    const rows = (data || []).filter(item => {
    if (seen.has(item.vchNumber)) return false;
    seen.add(item.vchNumber);
    return true;
    });

    /* apply the same visibility filters as before to build the row list */
    ckRows = rows.filter(item => {
    /* hide paid entries */
    if ((item.paymentStatus || "").toLowerCase() === "paid") return false;
    /* hide entries without attachment */
    if (!item.attachmentPath) return false;
    /* hide approved entries */
    if ((item.checkerStatus || "").toLowerCase() === "approved") return false;
    /* hide rejected entries */
    if ((item.checkerStatus || "").toLowerCase() === "rejected") return false;
    return true;
    });

    /* count reflects ALL rows that will be shown (not just the current page) */
    const rendered = ckRows.length;
    $("#checkerCount").text(rendered + " record" + (rendered !== 1 ? "s" : ""));

    if (rendered === 0) { $("#exportBtn").hide(); }
    else { $("#exportBtn").show(); }

    ckPage = 1;
    renderCkPage();
    }

    function ckRowHtml(item) {
    const cs = item.checkerStatus || "Pending";
    const statusBadge =
    cs === "Approved" ? `<span class="status-badge sb-approved"><i class="fa-solid fa-check"></i> Approved</span>` :
    cs === "Rejected" ? `<span class="status-badge sb-rejected"><i class="fa-solid fa-xmark"></i> Rejected</span>` :
    `<span class="status-badge sb-pending"><i class="fa-solid fa-clock"></i> Pending</span>`;

    const actionCell = cs === "Approved"
    ? `<span class="status-badge sb-approved"><i class="fa-solid fa-check"></i> Done</span>`
    : cs === "Rejected"
    ? `<span class="status-badge sb-rejected"><i class="fa-solid fa-ban"></i> Rejected</span>`
    : `<div class="action-cell">
    <button class="btn-approve approveBtn icon-only"
    data-vch="${safeValueAttr(item.vchNumber)}"
    data-account="${safeValueAttr(item.accountName ?? '')}"
    data-amount="${safeValueAttr(item.billAmount ?? '')}"
    title="Approve">
    <i class="fa-solid fa-check"></i>
    </button>
    <button class="btn-reject rejectBtn icon-only"
    data-vch="${safeValueAttr(item.vchNumber)}"
    data-account="${safeValueAttr(item.accountName ?? '')}"
    data-amount="${safeValueAttr(item.billAmount ?? '')}"
    title="Reject">
    <i class="fa-solid fa-xmark"></i>
    </button>
    </div>`;

    const attachHtml = item.attachmentPath
    ? `<a class="attach-view" href="#" onclick="openPdf('${safeValueAttr(item.attachmentPath)}');return false;">
    <i class="fa-solid fa-eye"></i> View
    </a>`
    : `<span class="muted-pill"><i class="fa-regular fa-file"></i>No File</span>`;

    return `
    <tr id="row-${item.vchNumber}" onclick="highlightRow(this)">
    <td class="td-account" title="${safeAttr(item.accountName ?? '')}">
    <a href="javascript:void(0)"
    onclick="loadDetails(${item.vchNumber},${item.serialNumber});event.stopPropagation();"
    class="account-drill-link">
    <span class="cell-text">${safeText(item.accountName ?? "")}</span>
    <i class="fa-solid fa-chevron-down"></i>
    </a>
    </td>
    <td class="td-voucher"><span class="cell-text">${safeText(item.vchNumber ?? "")}</span></td>
    <td class="td-date"><span class="cell-text">${safeText(formatDate(item.voucherDate))}</span></td>
    <td class="td-amount"><span class="cell-text">&#8377;${safeText(item.billAmount ?? "")}</span></td>
    <td class="td-supplier" title="${safeAttr(item.supplierRef || "-")}"><span class="cell-text">${safeText(item.supplierRef || "-")}</span></td>

    <td class="td-attachment">${attachHtml}</td>

    <td class="td-status">${statusBadge}</td>
    <td class="td-checker-remark">
    <input type="text"
    class="checker-remark-input checkerRemark"
    placeholder="Enter remark…"
    value="${safeValueAttr(item.checkerRemark ?? "")}"
    ${cs !== "Pending" ? 'readonly style="opacity:.6"' : ''} />
    </td>
    <td class="td-action-cell">${actionCell}</td>
    <td class="td-date"><span class="cell-text">${safeText(formatDate(item.dueDate))}</span></td>
    </tr>`;
    }

    function renderCkPage() {
    if (ckRows.length === 0) {
    $("#checkerTable").html(
    `<tr><td colspan="10" class="empty-row">
    <i class="fa-solid fa-inbox" style="font-size:22px;display:block;margin-bottom:8px;color:#D1D5DB"></i>
    No data found.
    </td></tr>`
    );
    $("#ck-from").text(0);
    $("#ck-to").text(0);
    $("#ck-total").text(0);
    $("#pg-btns-ck").empty();
    if (window._syncTopScroll) window._syncTopScroll();
    return;
    }

    const total = ckRows.length;
    const start = (ckPage - 1) * ckPerPage;
    const end = Math.min(start + ckPerPage, total);

    let html = "";
    ckRows.slice(start, end).forEach(item => { html += ckRowHtml(item); });
    $("#checkerTable").html(html);

    $("#ck-from").text(total ? start + 1 : 0);
    $("#ck-to").text(end);
    $("#ck-total").text(total);

    renderCkPagination(total);

    /* re-apply saved column visibility/order to the freshly rendered rows */
    if (window._applyCheckerLayout) window._applyCheckerLayout();
    if (window._syncTopScroll) window._syncTopScroll();
    }

    function renderCkPagination(total) {
    const pages = Math.ceil(total / ckPerPage);
    const box = $("#pg-btns-ck");
    box.empty();
    if (pages <= 1) return;

    box.append(`<button class="dt-pg-btn"${ckPage === 1 ? ' disabled' : ''} onclick="ckGoPage(${ckPage - 1})"><i class="fa-solid fa-chevron-left fa-xs"></i></button>`);

    ckPageNums(ckPage, pages).forEach(p => {
    if (p === '...') box.append('<span class="dt-pg-dots">…</span>');
    else box.append(`<button class="dt-pg-btn${p === ckPage ? ' active' : ''}" onclick="ckGoPage(${p})">${p}</button>`);
    });

    box.append(`<button class="dt-pg-btn"${ckPage === pages ? ' disabled' : ''} onclick="ckGoPage(${ckPage + 1})"><i class="fa-solid fa-chevron-right fa-xs"></i></button>`);
    }

    function ckPageNums(current, total) {
    if (total <= 7) { let a = []; for (let i = 1; i <= total; i++) a.push(i); return a; }
    let p = [1];
    if (current > 3) p.push('...');
    let lo = Math.max(2, current - 1), hi = Math.min(total - 1, current + 1);
    for (let j = lo; j <= hi; j++) p.push(j);
    if (current < total - 2) p.push('...');
    p.push(total);
    return p;
    }

    function ckGoPage(p) {
    ckPage = p;
    renderCkPage();
    window.scrollTo({ top: document.querySelector('.checker-table-card')?.offsetTop || 0, behavior: 'smooth' });
    }



