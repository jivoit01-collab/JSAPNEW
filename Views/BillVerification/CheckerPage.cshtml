

@{
    ViewData["Title"] = "Checker Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/bill-verification.css" />
<link rel="stylesheet" href="~/css/admin-premium.css" />

<style>
    /* ===== CHECKER TABLE: show full column names & values (no "..." truncation) ===== */
    .checker-dashboard-shell .checker-table-card table.dt.checker-workflow-table {
        table-layout: auto;
        width: auto;
        min-width: 0;
        margin-left: auto;
        margin-right: auto;
    }

    /* size every column to its text (ignore the forced fixed widths) */
    .checker-dashboard-shell .checker-workflow-table col {
        width: auto !important;
        min-width: 0 !important;
    }

    .checker-dashboard-shell .checker-workflow-table thead th,
    .checker-dashboard-shell .checker-workflow-table tbody td {
        width: auto !important;
        min-width: 0 !important;
    }

    .checker-dashboard-shell .checker-table-card table.dt.checker-workflow-table thead th,
    .checker-dashboard-shell .checker-table-card table.dt.checker-workflow-table tbody td {
        white-space: nowrap;
        overflow: visible;
        text-overflow: clip;
    }

    .checker-dashboard-shell .checker-table-card table.dt.checker-workflow-table .cell-text {
        max-width: none;
        overflow: visible;
        text-overflow: clip;
        white-space: nowrap;
    }

    /* selected row: remove the blue border/line on every column, keep a soft highlight */
    .checker-dashboard-shell .checker-table-card table.dt.checker-workflow-table tbody tr.row-selected td {
        box-shadow: none !important;
        border-left: 0 !important;
        background: rgba(239, 246, 255, 0.6) !important;
    }

    /* compact icon-only Approve / Reject action buttons (not big pills) */
    .checker-dashboard-shell .checker-workflow-table .btn-approve.icon-only,
    .checker-dashboard-shell .checker-workflow-table .btn-reject.icon-only {
        width: 32px !important;
        min-width: 32px !important;
        height: 32px !important;
        padding: 0 !important;
        border-radius: 8px !important;
        gap: 0 !important;
        font-size: 14px;
    }

    /* align action buttons under the ACTION header + reduce side spacing */
    .checker-dashboard-shell .checker-workflow-table .action-cell {
        justify-content: flex-start !important;
        gap: 6px !important;
    }

    .checker-dashboard-shell .checker-workflow-table td.td-action-cell {
        padding-left: 10px !important;
        padding-right: 10px !important;
    }

    /* keep the account suggestions dropdown above the table card */
    .checker-filter-card {
        position: relative;
        z-index: 40;
    }

    .checker-filter-card .suggestion-box {
        z-index: 3000;
    }

    /* ===== "Columns" toggle button ===== */
    .btn-columns {
        background: #fff;
        color: var(--primary-color, #0b2c4d);
        border: 1px solid #CBD5E1;
        font-weight: 600;
    }

        .btn-columns:hover {
            background: #F1F5F9;
            border-color: var(--primary-color, #0b2c4d);
        }

    /* ===== Right-side column drawer ===== */
    .col-drawer-overlay {
        position: fixed;
        inset: 0;
        background: rgba(11, 44, 77, 0.35);
        display: none;
        z-index: 1400;
    }

        .col-drawer-overlay.open {
            display: block;
        }

    .col-drawer {
        position: fixed;
        top: var(--header-height, 60px);
        right: 0;
        height: calc(100vh - var(--header-height, 60px));
        width: 320px;
        max-width: 85vw;
        background: #fff;
        box-shadow: -8px 0 30px rgba(11, 44, 77, 0.18);
        transform: translateX(100%);
        transition: transform 0.25s ease, visibility 0.25s ease;
        z-index: 1401;
        display: flex;
        flex-direction: column;
        visibility: hidden;
        pointer-events: none;
    }

        .col-drawer.open {
            transform: translateX(0);
            visibility: visible;
            pointer-events: auto;
        }

    .col-drawer-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 18px;
        background: linear-gradient(135deg, var(--primary-color, #0b2c4d) 0%, var(--primary-light, #1c3f5d) 100%);
        color: #fff;
        font-weight: 700;
    }

    .col-drawer-close {
        background: none;
        border: 0;
        color: #fff;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
    }

    .col-drawer-note {
        padding: 12px 18px 4px;
        font-size: 12px;
        color: #64748B;
    }

    .col-drawer-tools {
        display: flex;
        gap: 8px;
        padding: 10px 18px 6px;
        border-bottom: 1px solid #E2E8F0;
    }

    .col-tool-btn {
        flex: 1;
        border: 1px solid var(--primary-color, #0b2c4d);
        background: #fff;
        color: var(--primary-color, #0b2c4d);
        border-radius: 6px;
        padding: 7px 10px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.2s ease;
    }

        .col-tool-btn:hover {
            background: var(--primary-color, #0b2c4d);
            color: #fff;
        }

    /* template bar */
    .col-drawer-tpl {
        padding: 12px 18px;
        border-bottom: 1px solid #E2E8F0;
        background: #F8FBFF;
    }

    .col-tpl-label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: var(--primary-color, #0b2c4d);
        margin-bottom: 6px;
    }

    .col-tpl-select {
        width: 100%;
        padding: 7px 10px;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        font-size: 13px;
        color: #1F2937;
        background: #fff;
        margin-bottom: 8px;
    }

    .col-tpl-actions {
        display: flex;
        gap: 6px;
    }

    .col-drawer-body {
        padding: 6px 18px 18px;
        overflow-y: auto;
    }

    /* column row: checkbox + label + move arrows */
    .col-check {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px;
        border-bottom: 1px solid #F1F5F9;
        font-size: 14px;
        color: #1F2937;
        border-radius: 6px;
        transition: background 0.15s ease;
    }

        .col-check:hover {
            background: #EFF3F8;
        }

    .col-check-label {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
        min-width: 0;
        cursor: pointer;
    }

        .col-check-label span {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .col-check-label input {
            width: 16px;
            height: 16px;
            accent-color: var(--primary-color, #0b2c4d);
            cursor: pointer;
            flex: 0 0 auto;
        }

    .col-move {
        display: flex;
        gap: 4px;
        flex: 0 0 auto;
    }

    .col-move-btn {
        border: 1px solid #E2E8F0;
        background: #fff;
        color: var(--primary-color, #0b2c4d);
        border-radius: 5px;
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 11px;
        transition: all 0.15s ease;
    }

        .col-move-btn:hover:not(:disabled) {
            background: var(--primary-color, #0b2c4d);
            color: #fff;
        }

        .col-move-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }
</style>

