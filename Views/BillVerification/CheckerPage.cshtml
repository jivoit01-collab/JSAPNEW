    <td>₹${totalTax.toFixed(2)}</td>
    <td></td>
    <td>₹${totalAmount.toFixed(2)}</td>
    <td></td>
    </tr>`;
    const taxSummaryRows = buildGstTaxSummary(items);

    const el = document.getElementById("details-" + vchNumber);
    if (el) {
    el.outerHTML = `
