            </button>
        </div>

        <!-- TABLE -->
        <div class="t-card invoice-table-card">

            <div class="t-header">

                <span class="t-title">

                    <i class="fa-solid fa-money-check-dollar"></i>

                    Invoice Monitoring

                </span>

                <span class="t-count"
                      id="rowCount">

                    0 records

                </span>

            </div>

            <!-- TOP SCROLL -->
            <div class="top-scroll"
                 id="topScroll">

                <div class="top-scroll-inner"
                     id="topScrollInner">
                </div>

            </div>

            <!-- TABLE -->
            <div class="t-wrap"
                 id="tableWrap">

                <table class="dt invoice-payment-table"
                       id="mainTable">

                    <colgroup>
                        <col class="col-account" />
                        <col class="col-voucher" />
                        <col class="col-date" />
                        <col class="col-amount" />
                        <col class="col-supplier" />
                        <col class="col-date" />
                        <col class="col-date" />
                        <col class="col-attachment" />
                        <col class="col-checker-status" />
                        <col class="col-payment-status" />
                      
                        <col class="col-checker-remark" />
                        <col class="col-action" />
                    </colgroup>

                    <thead>

                        <tr>

                            <th>Account</th>
                            <th>MRN</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Supplier Ref</th>
                            <th>Ref Date</th>
                            <th>Due Date</th>
                            <th>Attachment</th>

                            <th>Checker Status</th>
                            <th>Payment Status</th>
                           
                            <th>Checker Remark</th>
                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody id="PaymentTable">

                        <tr>

                            <td colspan="12"
                                class="empty-row">

                                <i class="fa-solid fa-spinner fa-spin"></i>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

            <!-- PAGINATION (10 per page) -->
            <div class="dt-pagination" id="pg-ip">
                <div class="dt-pg-info">Showing <b id="ip-from">0</b>–<b id="ip-to">0</b> of <b id="ip-total">0</b></div>
                <div class="dt-pg-btns" id="pg-btns-ip"></div>
            </div>

