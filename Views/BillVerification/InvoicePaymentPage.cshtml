
@{
    ViewData["Title"] = "InvoicePaymentPage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/bill-verification.css" />
<link rel="stylesheet" href="~/css/admin-premium.css" />

<style>
    /* ===== INVOICE PAYMENT TABLE: full column values (no "..."), fit-to-text, centered ===== */
    .invoice-payment-shell .invoice-table-card table.dt.invoice-payment-table {
        table-layout: auto !important;
        width: auto !important;
        min-width: 0 !important;
        margin-left: auto;
        margin-right: auto;
    }

    .invoice-payment-shell .invoice-table-card table.dt.invoice-payment-table thead th,
    .invoice-payment-shell .invoice-table-card table.dt.invoice-payment-table tbody td {
        white-space: nowrap;
        overflow: visible;
        text-overflow: clip;
        width: auto !important;
        min-width: 0 !important;
    }

    .invoice-payment-shell .invoice-table-card table.dt.invoice-payment-table .cell-text,
    .invoice-payment-shell .invoice-table-card table.dt.invoice-payment-table .clamp-text {
        max-width: none !important;
        overflow: visible;
        text-overflow: clip;
        white-space: nowrap;
        -webkit-line-clamp: none;
        display: inline;
    }

    .invoice-payment-shell .invoice-table-card .invoice-payment-table col {
        width: auto !important;
        min-width: 0 !important;
    }

    /* keep the account suggestions dropdown above the table card */
    .invoice-filter-card {
        position: relative;
        z-index: 40;
    }

    /* the account field is the positioning anchor for its dropdown */
    .invoice-filter-card .autocomplete-group {
        position: relative;
    }

    /* ── Account name dropdown (combobox) ── */
    .invoice-filter-card .suggestion-box {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        z-index: 3000;
        max-height: 320px;
        overflow-y: auto;
        background: #ffffff;
        border: 1px solid #e5e9f2;
        border-radius: 16px;
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.18);
        padding: 8px;
        display: none;
    }

        .invoice-filter-card .suggestion-box .suggest-item {
            padding: 13px 16px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            color: #1e293b;
            cursor: pointer;
            transition: background .12s ease, color .12s ease;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .invoice-filter-card .suggestion-box .suggest-item:hover {
                background: #eff4ff;
                color: #1d4ed8;
            }

            .invoice-filter-card .suggestion-box .suggest-item.suggest-empty {
                color: #94a3b8;
                font-weight: 500;
                cursor: default;
                background: transparent;
            }

    /* nice thin scrollbar for the dropdown */
    .invoice-filter-card .suggestion-box::-webkit-scrollbar {
        width: 8px;
    }

    .invoice-filter-card .suggestion-box::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 8px;
    }

    /* ── Action column: Reject button ── */
    .invoice-payment-shell .td-action {
        text-align: center;
    }

    .invoice-payment-shell .ip-reject-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 9px;
        cursor: pointer;
        color: #fff;
        font-size: 15px;
        background: linear-gradient(135deg, #dc2626, #ef4444);
        box-shadow: 0 4px 12px rgba(220, 38, 38, .28);
        transition: transform .12s ease, box-shadow .12s ease, filter .12s ease;
    }

        .invoice-payment-shell .ip-reject-btn:hover {
            filter: brightness(1.06);
            transform: translateY(-1px);
            box-shadow: 0 7px 18px rgba(220, 38, 38, .38);
        }

        .invoice-payment-shell .ip-reject-btn:active {
            transform: translateY(0);
        }

    /* ── Reject modal (centered) ── */
    .ip-reject-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(15, 23, 42, .55);
        backdrop-filter: blur(3px);
    }

        .ip-reject-overlay.open {
            display: flex;
        }

    .ip-reject-card {
        width: 460px;
        max-width: calc(100vw - 40px);
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 30px 80px rgba(15, 23, 42, .35);
        overflow: hidden;
        animation: ipPop .16s ease;
    }

    @@keyframes ipPop {
        from {
            transform: scale(.94);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .ip-reject-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 22px;
        background: linear-gradient(135deg, #dc2626, #ef4444);
        color: #fff;
    }

        .ip-reject-head h3 {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 9px;
        }

    .ip-reject-close {
        background: rgba(255,255,255,.18);
        border: none;
        color: #fff;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 15px;
    }

        .ip-reject-close:hover {
            background: rgba(255,255,255,.30);
        }

    .ip-reject-body {
        padding: 20px 22px 8px;
    }

        .ip-reject-body .ip-acct {
            font-size: 13px;
            color: #64748b;
            margin-bottom: 14px;
        }

            .ip-reject-body .ip-acct b {
                color: #1e293b;
            }

        .ip-reject-body label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 6px;
        }

            .ip-reject-body label .req {
                color: #dc2626;
            }

        .ip-reject-body textarea {
            width: 100%;
            min-height: 96px;
            resize: vertical;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px 14px;
            font-size: 14px;
            font-family: inherit;
            outline: none;
            transition: border-color .15s ease;
        }

            .ip-reject-body textarea:focus {
                border-color: #ef4444;
            }

            .ip-reject-body textarea.err {
                border-color: #dc2626;
                background: #fef2f2;
            }

    .ip-reject-warn {
        color: #dc2626;
        font-size: 12.5px;
        margin-top: 6px;
        min-height: 16px;
    }

    .ip-reject-foot {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 12px 22px 20px;
    }

    .ip-btn-cancel {
        padding: 10px 18px;
        border-radius: 10px;
        border: 1.5px solid #e2e8f0;
        background: #fff;
        color: #475569;
        font-weight: 600;
        cursor: pointer;
    }

        .ip-btn-cancel:hover {
            background: #f8fafc;
        }

    .ip-btn-confirm {
        padding: 10px 20px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #dc2626, #ef4444);
        color: #fff;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 6px 16px rgba(220,38,38,.3);
    }

        .ip-btn-confirm:hover {
            filter: brightness(1.06);
        }

        .ip-btn-confirm:disabled {
            opacity: .6;
            cursor: not-allowed;
        }
</style>

<!-- ═══════════════════════════════════
     PREMIUM CONTENT
═══════════════════════════════════ -->
<div class="admin-dashboard-shell invoice-payment-shell">
    <nav class="premium-nav">
        <div class="nav-glass">
            <div class="nav-left-section">
                <div class="brand-logo-wrap">
