                    <img src="@Url.Content("~/images/js3.png")" class="product-img clickable-product" alt="Juice product" />
                    <img src="@Url.Content("~/images/Pomace-2-1000x1000.png")" class="product-img clickable-product" alt="Pomace oil" />
                    <img src="@Url.Content("~/images/Desi-Ghee.jpg")" class="product-img clickable-product" alt="Desi ghee" />
                    <img src="@Url.Content("~/images/download.jpg")" class="product-img" alt="Wellness product" />
                </div>
            </div>

            <div class="module-box invoice">
                <span class="module-dot"></span>
                <i class="fa-solid fa-money-check-dollar"></i>
                <span>Invoice Payment</span>
            </div>
        </div>
    </nav>

    <!-- PRODUCT MODAL -->
    <div id="productModal" class="product-modal">

        <span class="close-modal">&times;</span>

        <img id="modalProductImage"
             class="modal-product-image" />

    </div>

    <!-- REJECT MODAL (Payment Maker) -->
    <div class="ip-reject-overlay" id="ipRejectOverlay">
        <div class="ip-reject-card">
            <div class="ip-reject-head">
                <h3><i class="fa-solid fa-ban"></i> Reject Entry</h3>
                <button type="button" class="ip-reject-close" onclick="closeRejectModal()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="ip-reject-body">
                <div class="ip-acct">Account: <b id="ipRejectAccount">-</b></div>
                <label>Reject Remark <span class="req">*</span></label>
                <textarea id="ipRejectRemark"
