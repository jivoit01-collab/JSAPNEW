    </tr>
    `;
    }

    /* ═══════════════════════════════════════
    PAGINATION — 10 rows per page
    ═══════════════════════════════════════ */

    function renderIpPage() {
    if (ipRows.length === 0) {
    $("#PaymentTable").html(`
    <tr>
    <td colspan="12" class="empty-row">
    No Approved Records
    </td>
    </tr>
    `);
    $("#ip-from").text(0);
    $("#ip-to").text(0);
    $("#ip-total").text(0);
    $("#pg-btns-ip").empty();
    syncTopScroll();
    return;
    }

    const total = ipRows.length;
    const start = (ipPage - 1) * ipPerPage;
    const end = Math.min(start + ipPerPage, total);

    let html = "";
    ipRows.slice(start, end).forEach(item => { html += ipRowHtml(item); });
    $("#PaymentTable").html(html);

    $("#ip-from").text(total ? start + 1 : 0);
    $("#ip-to").text(end);
    $("#ip-total").text(total);

    renderIpPagination(total);
    syncTopScroll();
    }

    function renderIpPagination(total) {
    const pages = Math.ceil(total / ipPerPage);
    const box = $("#pg-btns-ip");
    box.empty();
    if (pages <= 1) return;

    box.append(`<button class="dt-pg-btn"${ipPage === 1 ? ' disabled' : ''} onclick="ipGoPage(${ipPage - 1})"><i class="fa-solid fa-chevron-left fa-xs"></i></button>`);

    ipPageNums(ipPage, pages).forEach(p => {
    if (p === '...') box.append('<span class="dt-pg-dots">…</span>');
    else box.append(`<button class="dt-pg-btn${p === ipPage ? ' active' : ''}" onclick="ipGoPage(${p})">${p}</button>`);
    });

    box.append(`<button class="dt-pg-btn"${ipPage === pages ? ' disabled' : ''} onclick="ipGoPage(${ipPage + 1})"><i class="fa-solid fa-chevron-right fa-xs"></i></button>`);
    }

    function ipPageNums(current, total) {
    if (total <= 7) { let a = []; for (let i = 1; i <= total; i++) a.push(i); return a; }
    let p = [1];
    if (current > 3) p.push('...');
    let lo = Math.max(2, current - 1), hi = Math.min(total - 1, current + 1);
    for (let j = lo; j <= hi; j++) p.push(j);
    if (current < total - 2) p.push('...');
    p.push(total);
    return p;
    }

    function ipGoPage(p) {
    ipPage = p;
    renderIpPage();
    window.scrollTo({ top: document.querySelector('.invoice-table-card')?.offsetTop || 0, behavior: 'smooth' });
    }

    /* ═══════════════════════════════════════
    DATE FORMAT
    ═══════════════════════════════════════ */

    function formatDate(ds) {

    if (!ds) return "";

    const d = new Date(ds);

    if (isNaN(d)) return ds;

    return d.toISOString().split("T")[0];

    }

