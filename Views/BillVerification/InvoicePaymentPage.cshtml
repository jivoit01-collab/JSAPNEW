                <div class="ip-reject-warn" id="ipRejectWarn"></div>
            </div>
            <div class="ip-reject-foot">
                <button type="button" class="ip-btn-cancel" onclick="closeRejectModal()">Cancel</button>
                <button type="button" class="ip-btn-confirm" id="ipRejectConfirm" onclick="submitReject()">
                    <i class="fa-solid fa-ban"></i> Reject
                </button>
            </div>
        </div>
    </div>

    <div class="body admin-dashboard-body">

        <!-- KPI -->
        <div class="kpi-grid">

            <div class="kpi-card k-blue">
                <div class="kpi-top">
                    <div>
                        <div class="kpi-val" id="kpi-total">0</div>
                        <div class="kpi-label">Total Unpaid Bills</div>
                    </div>
                    <div class="kpi-icon">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                </div>
                <div class="kpi-bottom">
                    <svg class="kpi-wave" viewBox="0 0 80 28" fill="none">
                        <polyline points="0,20 12,14 24,18 36,8 48,14 60,6 72,12 80,8"
                                  stroke="#3B82F6" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <div class="kpi-trend"><i class="fa-solid fa-list-check fa-xs"></i> Ready</div>
                </div>
            </div>

            <div class="kpi-card k-amber">
                <div class="kpi-top">
                    <div>
                        <div class="kpi-val" id="kpi-unpaid">0</div>
                        <div class="kpi-label">
                            Pending Amount
                        </div>
                    </div>
                    <div class="kpi-icon">
                        <i class="fa-solid fa-indian-rupee-sign"></i>
                    </div>
                </div>
                <div class="kpi-bottom">
                    <svg class="kpi-wave" viewBox="0 0 80 28" fill="none">
                        <polyline points="0,12 12,18 24,10 36,20 48,12 60,18 72,8 80,14"
                                  stroke="#F59E0B" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <div class="kpi-trend"><i class="fa-solid fa-clock fa-xs"></i> Pending</div>
                </div>
            </div>

            <div class="kpi-card k-green">
                <div class="kpi-top">
                    <div>
                        <div class="kpi-val" id="kpi-paid">0</div>
                        <div class="kpi-label"> Vendors Pending </div>
                    </div>
                    <div class="kpi-icon">
                        <i class="fa-solid fa-building"></i>
                    </div>
                </div>
                <div class="kpi-bottom">
                    <svg class="kpi-wave" viewBox="0 0 80 28" fill="none">
                        <polyline points="0,18 12,10 24,16 36,7 48,13 60,5 72,12 80,8"
                                  stroke="#22C55E" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <div class="kpi-trend"><i class="fa-solid fa-users fa-xs"></i> Vendors</div>
                </div>
            </div>

            <div class="kpi-card k-purple">
                <div class="kpi-top">
                    <div>
                        <div class="kpi-val" id="kpi-amount">0</div>
                        <div class="kpi-label"> Overdue Bills </div>
                    </div>
                    <div class="kpi-icon">
                        <i class="fa-solid fa-calendar-xmark"></i>
                    </div>
                </div>
                <div class="kpi-bottom">
                    <svg class="kpi-wave" viewBox="0 0 80 28" fill="none">
                        <polyline points="0,20 12,12 24,18 36,10 48,18 60,8 72,15 80,9"
                                  stroke="#8B5CF6" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <div class="kpi-trend"><i class="fa-solid fa-triangle-exclamation fa-xs"></i> Overdue</div>
                </div>
            </div>

        </div>

        <!-- PDF -->
        <div id="pdfContainer" class="pdf-modal">

            <div class="pdf-box">

                <button onclick="closePdf()"
                        class="pdf-close">

                    ×

                </button>

                <iframe id="pdfFrame"></iframe>

            </div>

        </div>

        <!-- FILTER -->
