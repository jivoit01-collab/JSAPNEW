    /* ═══════════════════════════════════════
    ACCOUNT NAME — omni search + click-to-open dropdown (combobox)
    ═══════════════════════════════════════ */
    function loadInvoiceAccountSuggestions() {
    const term = $("#accountName").val().trim();
    $.get("/Maker/GetAccountSuggestions", { term }, function (data) {
    let html = "";
    if (!data || !data.length) {
    html = `<div class="suggest-item suggest-empty">No result</div>`;
    } else {
    data.forEach(x => { html += `<div class="suggest-item">${x}</div>`; });
    }
    $("#suggestionBox").html(html).show();
    });
    }

    function initAccountSuggestions() {
    /* open on focus/click (shows options even before typing) and filter while typing */
    $("#accountName").on("focus click keyup", loadInvoiceAccountSuggestions);

    $(document).on("mousedown", "#suggestionBox .suggest-item", function (e) {
    e.preventDefault();
    if ($(this).hasClass("suggest-empty")) return;
    $("#accountName").val($(this).text().trim());
    $("#suggestionBox").empty().hide();
    });

    $(document).on("click", function (e) {
    if (!$(e.target).closest("#accountName, #suggestionBox").length)
    $("#suggestionBox").empty().hide();
    });
    }

    /* ═══════════════════════════════════════
    REJECT ENTRY (Payment Maker) — mandatory remark
    ═══════════════════════════════════════ */
    let ipRejectVch = null;

    function openRejectModal(vchNumber, accountName) {
    ipRejectVch = vchNumber;
    $("#ipRejectAccount").text(accountName || "-");
    $("#ipRejectRemark").val("").removeClass("err");
    $("#ipRejectWarn").text("");
    $("#ipRejectConfirm").prop("disabled", false)
    .html('<i class="fa-solid fa-ban"></i> Reject');
    $("#ipRejectOverlay").addClass("open");
    setTimeout(() => $("#ipRejectRemark").focus(), 60);
    }

    function closeRejectModal() {
    $("#ipRejectOverlay").removeClass("open");
    ipRejectVch = null;
    }

    function submitReject() {
    const remark = $("#ipRejectRemark").val().trim();

    /* remark is MANDATORY */
    if (!remark) {
    $("#ipRejectRemark").addClass("err").focus();
    $("#ipRejectWarn").text("Remark is required to reject an entry.");
    return;
    }

    const btn = $("#ipRejectConfirm");
    btn.prop("disabled", true)
    .html('<i class="fa-solid fa-spinner fa-spin"></i> Rejecting...');

    $.ajax({
    url: "/InvoicePayment/Reject",
    type: "POST",
    contentType: "application/json",
    data: JSON.stringify({ vchNumber: ipRejectVch, remark: remark }),
    success: function (res) {
    if (res && res.success) {
    closeRejectModal();
    loadData();
    } else {
    $("#ipRejectWarn").text((res && res.message) || "Unable to reject entry.");
    btn.prop("disabled", false).html('<i class="fa-solid fa-ban"></i> Reject');
    }
    },
    error: function () {
    $("#ipRejectWarn").text("Something went wrong. Please try again.");
    btn.prop("disabled", false).html('<i class="fa-solid fa-ban"></i> Reject');
    }
    });
    }

    /* close on backdrop click + Esc */
    $(document).on("mousedown", "#ipRejectOverlay", function (e) {
    if (e.target === this) closeRejectModal();
    });
    $(document).on("keydown", function (e) {
    if (e.key === "Escape" && $("#ipRejectOverlay").hasClass("open")) closeRejectModal();
    });
    function exportToExcel() {

    var data = (_invoiceDataCache || []).filter(function(item) {
    return item.checkerStatus === "Approved" && item.paymentStatus === "UnPaid";
    });

    if (!data.length) { alert("No data to export"); return; }

    var fromDate = $("#fromDate").val() || "all";
    var toDate   = $("#toDate").val()   || "";
    var filename = "invoice-payment_" + fromDate + (toDate ? "_to_" + toDate : "") + ".csv";

    var rows = [];
    rows.push([
    "Account Name","Voucher No","Voucher Date","Bill Amount",
    "Supplier Ref","Ref Date","Due Date",
    "Checker Status","Payment Status",
  ,"Checker Remark"
    ]);

    data.forEach(function(item) {
    rows.push([
    item.accountName   || "",
    item.vchNumber     || "",
    formatDate(item.voucherDate)      || "",
    item.billAmount    || "",
    item.supplierRef   || "",
    formatDate(item.supplierRefDate)  || "",
    formatDate(item.dueDate)          || "",
    item.checkerStatus || "",
    item.paymentStatus || "",
 
    item.checkerRemark || ""
    ]);
    });

    var totalAmt    = data.reduce(function(s,x){ return s + (parseFloat(x.billAmount)||0); }, 0);
    var overdue     = 0;
    var today       = new Date(); today.setHours(0,0,0,0);
    data.forEach(function(x) {
    if (x.dueDate) { var d = new Date(x.dueDate); d.setHours(0,0,0,0); if(d<today) overdue++; }
    });
    var vendors = new Set(data.map(function(x){ return x.accountName; })).size;

    rows.push([]);
    rows.push(["TOTALS","","","₹" + totalAmt.toLocaleString("en-IN"),"","","","","","",""]);
    rows.push(["Unique Vendors","" + vendors,"Overdue Bills","" + overdue,"","","","","","",""]);

    downloadCSV(rows, filename);
    }
    /* ═══════════════════════════════════════
    SHARED CSV EXPORT UTILITY
    Add once per page — handles all escaping,
    BOM, and clean formatting.
    ═══════════════════════════════════════ */
    function downloadCSV(rows, filename) {
    var BOM = "\uFEFF"; // UTF-8 BOM — ensures Excel opens with correct encoding
    var csv = BOM + rows.map(function(row) {
    return row.map(function(cell) {
    var v = (cell === null || cell === undefined) ? "" : String(cell);
    // Normalise whitespace — remove line breaks, collapse spaces
    v = v.replace(/[\r\n\t]+/g, " ").replace(/\s{2,}/g, " ").trim();
    // Escape double-quotes
    v = v.replace(/"/g, '""');
    // Always quote every cell for safety
    return '"' + v + '"';
    }).join(",");
    }).join("\r\n");

    var blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
    var url  = URL.createObjectURL(blob);
    var a    = document.createElement("a");
    a.href     = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    }

