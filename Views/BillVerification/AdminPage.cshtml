<style>
    /* ===== COMBINED BILLS TABLE: full column values (no "..."), fit-to-text ===== */
    .admin-dashboard-shell table.dt.dt-combined {
        table-layout: auto !important;
        width: auto !important;
        min-width: 100%;
    }

        .admin-dashboard-shell table.dt.dt-combined thead th,
        .admin-dashboard-shell table.dt.dt-combined tbody td {
            white-space: nowrap;
            overflow: visible;
            text-overflow: clip;
            width: auto !important;
            min-width: 0 !important;
        }

        .admin-dashboard-shell table.dt.dt-combined .cell-text,
        .admin-dashboard-shell table.dt.dt-combined .clamp-text {
            max-width: none !important;
            overflow: visible;
            text-overflow: clip;
            white-space: nowrap;
            -webkit-line-clamp: none;
            display: inline;
        }

        .admin-dashboard-shell table.dt.dt-combined col {
            width: auto !important;
            min-width: 0 !important;
        }

    /* keep the account suggestions dropdown above the KPI/table */
    .dashboard-filter-card {
        position: relative;
        z-index: 40;
    }

    .dashboard-filter-card .autocomplete-group {
        position: relative;
    }

    /* ── Account name dropdown (combobox) ── */
    .dashboard-filter-card .suggestion-box {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        z-index: 3000;
        max-height: 320px;
        overflow-y: auto;
        background: #ffffff;
        border: 1px solid #e5e9f2;
        border-radius: 16px;
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.18);
        padding: 8px;
        display: none;
    }

        .dashboard-filter-card .suggestion-box .suggest-item {
            padding: 13px 16px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            color: #1e293b;
            cursor: pointer;
            transition: background .12s ease, color .12s ease;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .dashboard-filter-card .suggestion-box .suggest-item:hover {
                background: #eff4ff;
                color: #1d4ed8;
            }

            .dashboard-filter-card .suggestion-box .suggest-item.suggest-empty {
                color: #94a3b8;
                font-weight: 500;
                cursor: default;
                background: transparent;
            }

    .dashboard-filter-card .suggestion-box::-webkit-scrollbar {
        width: 8px;
    }

    .dashboard-filter-card .suggestion-box::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 8px;
    }

    /* ── Admin "Attach file" button (rows with no attachment) ── */
    .admin-dashboard-shell .btn-attach-admin {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border: 1px dashed #3b82f6;
        border-radius: 8px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        transition: background .12s ease, box-shadow .12s ease;
    }

        .admin-dashboard-shell .btn-attach-admin:hover {
            background: #dbeafe;
            box-shadow: 0 4px 12px rgba(37, 99, 235, .18);
        }
</style>


