    function loadAdminCheckerDetails(vchNumber, serialNumber) {
    const existing = document.getElementById("admin-details-" + vchNumber);
    if (existing) {
    existing.remove();
    return;
    }

    document.querySelectorAll("[id^='admin-details-']").forEach(el => el.remove());

