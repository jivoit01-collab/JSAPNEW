<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
    
    /* ══════════════════════════════════════════
    PAGINATION STATE
    ══════════════════════════════════════════ */
    var pgState = {
    combined:       { page: 1, perPage: 10, data: [] }
    };

    /* ══════════════════════════════════════════
    PAGINATION HELPERS
    ══════════════════════════════════════════ */
    function renderPagination(tab) {
    var s     = pgState[tab];
    var total = s.data.length;
    var pages = Math.ceil(total / s.perPage);
    var start = (s.page - 1) * s.perPage;
    var end   = Math.min(start + s.perPage, total);

    $('#' + tab + '-from').text(total ? start + 1 : 0);
    $('#' + tab + '-to').text(end);
    $('#' + tab + '-total').text(total);

    var btnContainer = $('#pg-btns-' + tab);
    btnContainer.empty();

    if (pages <= 1) return;

    // Prev
    btnContainer.append(
    '<button class="dt-pg-btn"' + (s.page === 1 ? ' disabled' : '') +
    ' onclick="goPage(\'' + tab + '\',' + (s.page - 1) + ')">' +
    '<i class="fa-solid fa-chevron-left fa-xs"></i></button>'
    );

    // Page numbers with ellipsis
    var pageNums = buildPageNums(s.page, pages);
    pageNums.forEach(function(p) {
    if (p === '...') {
    btnContainer.append('<span class="dt-pg-dots">…</span>');
    } else {
    btnContainer.append(
    '<button class="dt-pg-btn' + (p === s.page ? ' active' : '') +
    '" onclick="goPage(\'' + tab + '\',' + p + ')">' + p + '</button>'
    );
    }
    });

    // Next
    btnContainer.append(
    '<button class="dt-pg-btn"' + (s.page === pages ? ' disabled' : '') +
    ' onclick="goPage(\'' + tab + '\',' + (s.page + 1) + ')">' +
    '<i class="fa-solid fa-chevron-right fa-xs"></i></button>'
    );
    }

    function buildPageNums(current, total) {
    if (total <= 7) {
    var arr = [];
    for (var i = 1; i <= total; i++) arr.push(i);
    return arr;
    }
    var pages = [1];
    if (current > 3) pages.push('...');
    var lo = Math.max(2, current - 1);
    var hi = Math.min(total - 1, current + 1);
    for (var j = lo; j <= hi; j++) pages.push(j);
    if (current < total - 2) pages.push('...');
    pages.push(total);
    return pages;
    }

    function goPage(tab, page) {
    pgState[tab].page = page;
    renderTabBody(tab);
    renderPagination(tab);
    }

    function changePerPage(tab, val) {
    pgState[tab].perPage = parseInt(val);
    pgState[tab].page    = 1;
    renderTabBody(tab);
    renderPagination(tab);
    }

    /* ══════════════════════════════════════════
    INIT
    ══════════════════════════════════════════ */
    $(document).ready(function () {

    /* default both dates to today */
    (function () {
    const t = new Date();
    const today = t.getFullYear() + "-" +
    String(t.getMonth() + 1).padStart(2, "0") + "-" +
    String(t.getDate()).padStart(2, "0");
    $("#fromDate").val(today);
    $("#toDate").val(today);
    })();

    initAccountSuggestions();
    loadSummary();
    loadCombined();
    });
    $("#confirmCancel").on("click", function () {
    closeConfirm();
    });

    function loadAllData() {
    loadSummary();
    loadCombined();
    }

    /* ══════════════════════════════════════════
    COMBINED BILLS TABLE (all bills across every stage)
    ══════════════════════════════════════════ */
    let combinedDataCache = [];

    function loadCombined() {
    $.get('/Admin/GetMakerActivity', getFilters(), function (data) {
    combinedDataCache = data || [];
    applyCombinedFilters();
    });
    }

    /* client-side Status / Payment / Attachment filters */
    function applyCombinedFilters() {
    const st = ($('#dd-status-combined').val()  || '');
    const pay = ($('#dd-payment-combined').val() || '');
    const at  = ($('#dd-attach-combined').val()  || '');

    const filtered = combinedDataCache.filter(function (x) {
    if (st  && (x.checkerStatus || 'Pending') !== st) return false;
    if (pay && (x.paymentStatus  || 'UnPaid')  !== pay) return false;
    if (at === 'yes' && !x.attachmentPath) return false;
    if (at === 'no'  &&  x.attachmentPath) return false;
    return true;
    });

    pgState.combined.data = filtered;
    pgState.combined.page = 1;
    $('#combinedCount').text(filtered.length + ' records');
    renderTabBody('combined');
    renderPagination('combined');
    /* recalc the horizontal top-scroll width to match the freshly rendered table */
    setTimeout(function () { window.dispatchEvent(new Event('resize')); }, 50);
    }

    function filterCombinedTable() {
    applyCombinedFilters();
    }

    function resetCombinedFilters() {
    $('#dd-status-combined').val('');
    $('#dd-payment-combined').val('');
    $('#dd-attach-combined').val('');
    applyCombinedFilters();
    }

    /* ══════════════════════════════════════════
    ADMIN ATTACH FILE — for entries that have no attachment
    ══════════════════════════════════════════ */
    function adminAttachmentCell(x) {
    if (x.attachmentPath) {
    return attachmentLink(x.attachmentPath);
    }
    return `
    <button class="btn-attach-admin" type="button"
    onclick="adminAttachFile('${safeValueAttr(x.vchNumber)}')"
    title="Attach a file for this entry">
    <i class="fa-solid fa-paperclip"></i> Attach
    </button>`;
    }

    let adminAttachVch = null;

    function adminAttachFile(vchNumber) {
    adminAttachVch = vchNumber;
    const input = document.getElementById('adminAttachInput');
    input.value = '';          // allow re-selecting the same file
    input.click();
    }

    $(document).on('change', '#adminAttachInput', function () {
    const file = this.files && this.files[0];
    if (!file || !adminAttachVch) return;

    const fd = new FormData();
    fd.append('vchNumber', adminAttachVch);
    fd.append('file', file);

    $.ajax({
    url: '/Admin/AttachFile',
    type: 'POST',
    data: fd,
    processData: false,
    contentType: false,
    success: function (res) {
    if (res && res.success) {
    loadCombined();
