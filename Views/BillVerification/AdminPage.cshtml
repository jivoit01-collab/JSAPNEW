    <td class="erp-qty">${safeText(item.quantity ?? 0)}</td>
    <td class="erp-rate">₹${safeText(item.purchaseRate ?? 0)}</td>
    <td class="erp-disc">${safeText(item.discountPercent ?? 0)}%</td>
    <td class="erp-margin">${safeText(item.margin ?? 0)}%</td>
    <td class="erp-taxrate">${safeText(item.taxRate ?? 0)}%</td>
    <td class="erp-taxamount">₹${safeText(item.taxAmount ?? 0)}</td>
    <td class="erp-mrp">₹${safeText(item.mrp ?? 0)}</td>
    <td class="erp-amount">₹${safeText(item.amount ?? 0)}</td>
    <td class="erp-sno">${safeText(item.serialNumber ?? idx + 1)}</td>
    </tr>
    `).join("") + `
    <tr style="background:#f8fafc;font-weight:700;border-top:2px solid #ccc;">
    <td>TOTAL</td>
    <td>${totalQty.toFixed(2)}</td>
    <td colspan="4"></td>
    <td>₹${totalTax.toFixed(2)}</td>
    <td></td>
    <td>₹${totalAmount.toFixed(2)}</td>
    <td></td>
    </tr>`
    : `
    <tr class="erp-item-row">
    <td colspan="10" class="erp-empty">No items found.</td>
    </tr>`;
    const taxSummaryRows = buildGstTaxSummary(items);

    const el = document.getElementById("admin-details-" + vchNumber);
    if (el) {
    el.outerHTML = `
    <tr id="admin-details-${safeValueAttr(vchNumber)}" class="detail-row">
